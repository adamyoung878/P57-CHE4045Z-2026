 204  *==============================================================================================================
 205  *CHP: TURBINES, BOILER AND STEAM HEADERS
 206  *==============================================================================================================
 207  Sets
 208  T   Turbines            /Tb1, Tb2/
 209  Ws  Water streams       /ws1, ws2, ws3, ws4, ws5, ws6/
 210  Stp Stream properties   /sTmp1, sTmp2, sE2, sCst/;
 211   
 212  *Columns: sTmp1 and sTmp2 inlet and outlet temperature [C]; sE2 enthalpy [kJ per kg]; sCst cost [$ per m3]
 213  Table   Streamproperties(Ws,Stp) Water stream data
 214                  sTmp1   sTmp2   sE2     sCst
 215          ws1     30      30      125.7   0
 216          ws2     30      60      271.9   0
 217          ws3     120     85      0       0
 218          ws4     30      0       125.7   0
 219          ws5     25      80      0       0
 220          ws6     25      45      2675.57 0.016;
 221   
 222  Parameters
 223  MaxG(T)         Maximum turbine generative capacity [kW]                                    /Tb1 6250,
 224                                                                                              Tb2 9000/
 225  MinG(T)         Minimum turbine generative capacity [kW]                                    /Tb1 2500,
 226                                                                                              Tb2 3000/
 227  MaxInF(T)       Maximum inlet flow of each turbine [kg per s]
 228  MaxCndF(T)      Maximum condensing flow of turbine 1 [kg per s]
 229  MaxIntF(T)      Maximum flow through turbine 1 past its MPS extraction I1 - HE1 [kg per s]
 230  MaxLPSout(T)    Maximum LPS exhaust of turbine 2 [kg per s]
 231  h_LPS           Enthalpy of superheated LPS [kJ per kg]                                     /2910.76/
 232  h_LPSd          Enthalpy of desuperheated LPS [kJ per kg]                                   /2752.78/
 233  h_MPS           Enthalpy of superheated MPS [kJ per kg]                                     /2948.90/
 234  h_MPSd          Enthalpy of desuperheated MPS [kJ per kg]                                   /2798.21/
 235  h_HPS           Enthalpy of superheated HPS [kJ per kg]                                     /3162.89/
 236  h_HPSd          Enthalpy of desuperheated HPS [kJ per kg]                                   /2798.90/
 237  hw_ds           Enthalpy of the 25 C desuperheating spray water [kJ per kg]                 /104.93/
 238  h_Cex           Enthalpy of turbine-1 condensing exhaust [kJ per kg]                        /2357.44/
 239  h_fw            Feed-water enthalpy [kJ per kg];
 240   
 241  MaxInF('Tb1')       = 87089.66/3600;
 242  MaxInF('Tb2')       = 110676.45/3600;
 243  MaxCndF('Tb1')      = 28122.70/3600;
 244  MaxIntF('Tb1')      = 59874.144/3600;
 245  MaxLPSout('Tb2')    = 64410.06/3600;
 246  h_fw                = Streamproperties('ws1','sE2');
 247   
 248  Positive Variables
 249  I1                  Inlet flow to turbine 1 [kg per s]
 250  I2                  Inlet flow to turbine 2 [kg per s]
 251  HE1                 Turbine-1 extraction to the 195 psig MPS header [kg per s]
 252  HE2                 Turbine-2 extraction to the 195 psig MPS header [kg per s]
 253  LE1                 Turbine-1 exhaust to the 62 psig LPS header [kg per s]
 254  LE2                 Turbine-2 exhaust to the 62 psig LPS header [kg per s]
 255  C                   Turbine-1 condensing flow to its own condenser [kg per s]
 256  P(T)                Power generated by each turbine [kW]
 257  BF1                 Let-down from the 635 psig HPS header to the MPS header [kg per s]
 258  BF2                 Let-down from the 195 psig MPS header to the LPS header [kg per s]
 259  HPST                HPS raised in the boiler into the 635 psig header [kg per s]
 260  MPS                 MPS leaving the 195 psig header [kg per s]
 261  LPS                 LPS leaving the 62 psig header [kg per s]
 262  Qb                  Boiler heat from fuel [kW]
 263  InletflowHEN        HPS sent from the HPS header to the HEN before desuperheating [kg per s]
 264  Q_crB               Crypto-Farm heat added to the boiler feed water [kW]
 265  Q_fw                Solar heat added to the boiler feed water [kW]
 266  SCN_CHP_Pw          CHP power above the demand and the Farm: wasted [kW]
 267  CR_Pco              CHP power used by the crypto Farm [kW];
 268   
 269  Equations
 270  MaxGE(T)            Turbine power at most MaxG
 271  MinGE(T)            Turbine power at least MinG
 272  MaxInFE             Turbine-1 inlet limit
 273  MaxInFE2            Turbine-2 inlet limit
 274  MaxCndFE            Turbine-1 condensing-flow limit
 275  MaxIntFE            Turbine-1 limit past the MPS extraction
 276  MaxLPSoutE          Turbine-2 LPS exhaust limit
 277  SeasonDuty(s)       Boiler heat from fuel is the same in every season
 278  HPSb                Boiler energy balance: HPS from fuel heat plus solar and crypto-Farm preheat
 279  M1                  HPS header balance
 280  M2                  Turbine and let-down balance
 281  M3                  Turbine-1 flow balance
 282  M4                  Turbine-2 flow balance
 283  M5                  MPS header balance
 284  M6                  LPS header balance
 285  PowerDemand         Turbines meet the minimum industrial demand D_ind
 286  ESCN_CHP_Pw         CHP output serves the industrial demand and then the Farm and the rest is wasted
 287  EB1                 Turbine-1 energy balance
 288  EB2                 Turbine-2 energy balance;
 289   
 290  *Power generation
 291  MaxGE(T)$act('1')..
 292      P(T) =l= MaxG(T);
 293  MinGE(T)$act('1')..
 294      P(T) =g= MinG(T);
 295  MaxInFE$act('1')..
 296      I1 =l= MaxInF('Tb1');
 297  MaxInFE2$act('1')..
 298      I2 =l= MaxInF('Tb2');
 299  MaxCndFE$act('1')..
 300      C =l= MaxCndF('Tb1');
 301  MaxIntFE$act('1')..
 302      I1 - HE1 =l= MaxIntF('Tb1');
 303  MaxLPSoutE$act('1')..
 304      LE2 =l= MaxLPSout('Tb2');
 305   
 306  *Boiler balance
 307  SeasonDuty(s)$act('1')..
 308      sum(sp, bb(sp,s)) =e= Qb;
 309  HPSb$act('1')..
 310      HPST*(h_HPS - h_fw) =e= Qb + Q_fw + Q_crB;
 311   
 312  *Material balances
 313  M1$act('1')..
 314      HPST - I2 - I1 - BF1-InletflowHEN =e= 0;
 315  M2$act('1')..
 316      I1 + I2 + BF1 - C - MPS - LPS =e= 0;
 317  M3$act('1')..
 318      I1 - HE1 - LE1 - C =e= 0;
 319  M4$act('1')..
 320      I2 - HE2 - LE2 =e= 0;
 321  M5$act('1')..
 322      HE1 + HE2 + BF1 - BF2 - MPS =e= 0;
 323  M6$act('1')..
 324      LE1 + LE2 + BF2 - LPS =e= 0;
 325   
 326  *Demand
 327  PowerDemand$act('1')..
 328      P('Tb1') + P('Tb2') =g= D_ind;
 329   
 330  *The CHP output serves D_ind, then the Farm (CR_Pco); the remainder SCN_CHP_Pw is wasted
 331  ESCN_CHP_Pw$act('1')..
 332      P('Tb1') + P('Tb2') =e= D_ind + CR_Pco + SCN_CHP_Pw;
 333   
 334  *Energy balances
 335  EB1$act('1')..
 336      h_HPS*I1 - h_MPS*HE1 - h_LPS*LE1 - h_Cex*C - P('Tb1') =e= 0;
 337  EB2$act('1')..
 338      h_HPS*I2 - h_MPS*HE2 - h_LPS*LE2 - P('Tb2') =e= 0;
 339   
 340  *==============================================================================================================
 341  *CHP: SOLAR FEED PREHEAT AND MAKE-UP WATER
 342  *==============================================================================================================
 343  Parameters
 344  Ta          Ambient temperature [C]                                                     /32/
 345  GHI         Global horizontal irradiation [kW per m2]                                   /0.8/
 346  aa1         First-order heat-loss coefficient of the solar collector [kW per m2.K]      /0.00153/
 347  aa2         Second-order heat-loss coefficient of the solar collector [kW per m2.K2]    /0.0000003/
 348  n           Zero-loss efficiency of the solar collector                                 /0.764/
 349  SPc         Solar panel cost [$ per m2]                                                 /100/
 350  wc          Price of boiler water [$ per m3]                                            /0.15/
 351  CP_s        Heat capacity of thermal storage stream [kJ per kg.K]                       /4.2/
 352  r           Density of thermal storage stream [kg per m3]                               /1000/
 353  U_st        Overall U of the storage exchanger (unsourced) [kW per m2.K]                /0.25/
 354  CST         Cost per unit volume of thermal storage tank [$ per m3]                     /50/
 355  CHE         Cost per unit area of the solar exchanger [$ per m2]                        /641.7/
 356  CI          Cost exponent of the solar exchanger                                        /0.83/
 357  epsHE       Area shift keeping the HE cost gradient finite at zero area [m2]            /1e-3/
 358  HEI         Heat exchanger installation cost [$]                                        /8333.3/
 359  HPSTmax     Upper bound on HPST from fuel supply with full solar and Farm preheat [kg per s]
 360  dT1_HE1     Solar exchanger terminal difference at the ws2 inlet [K]
 361  dT2_HE1     Solar exchanger terminal difference at the ws2 outlet [K]
 362  LMTD_HE1    Log-mean temperature difference of the solar exchanger [K];
 363   
 364  dT1_HE1     = Streamproperties('ws3','sTmp1') - Streamproperties('ws2','sTmp1');
 365  dT2_HE1     = Streamproperties('ws3','sTmp2') - Streamproperties('ws2','sTmp2');
 366  LMTD_HE1    = (dT1_HE1 - dT2_HE1)/log(dT1_HE1/dT2_HE1);
 367   
 368  Positive Variables
 369  Fws(Ws) Flow of each water stream [kg per s]
 370  wD      Boiler make-up water [kg per s]
 371  wTC     Make-up water cost [$ per year]
 372  T_c     Average collector temperature [C]
 373  ASP     Area of solar panel [m2]
 374  VST     Volume of thermal storage tank [m3]
 375  AHE1    Solar exchanger area [m2];
 376   
 377  Binary Variables
 378  S_A Solar preheat of the boiler feed is built;
 379   
 380  Equations
 381  WaterB      Boiler make-up water balance
 382  WaterC      Make-up water cost [$ per year]
 383  FeedQ       Solar heat added to the feed water
 384  EFWS2       Preheated feed only when solar is built
 385  EFWS3       Feed water is the cold plus the preheated stream
 386  SpTc        Average collector temperature
 387  AreaSP      Solar collector area
 388  AreaHE1     Solar exchanger area
 389  VolumeST    Thermal storage volume;
 390   
 391  WaterB$act('1')..
 392      wD-C =e= HPST;
 393  WaterC$act('1')..
 394      wTC =e= wD*wc*OH*3.6;
 395  FeedQ$act('1')..
 396      Q_fw =e= Fws('ws2')*CP_s*(Streamproperties('ws2','sTmp2')-Streamproperties('ws2','sTmp1'));
 397   
 398  EFWS2$act('1')..
 399      Fws('ws2') =l= HPSTmax*S_A;
 400  EFWS3$act('1')..
 401      HPST =e= Fws('ws2') + Fws('ws1');
 402   
 403  SpTc$act('1')..
 404      T_c =e= (((Streamproperties('ws2','sTmp1'))+(Streamproperties('ws2','sTmp2')))/2);
 405  AreaSP$act('1')..
 406      ASP =e= ((Fws('ws2')*((Streamproperties('ws2','sTmp2'))-(Streamproperties('ws2','sTmp1')))*CP_s) + (Fws('ws5')*((Streamproperties('ws5','sTmp2'))-(Streamproperties('ws5','sTmp1')))*CP_s)) / ((n*GHI)-(aa1*(T_c-Ta))-(aa2*(T_c-Ta)*(T_c-Ta)));
 407  AreaHE1$act('1')..
 408      AHE1 =e= Fws('ws2')*((Streamproperties('ws2','sTmp2'))-(Streamproperties('ws2','sTmp1')))*CP_s/(LMTD_HE1*U_st);
 409  VolumeST$act('1')..
 410      VST =e= (((Fws('ws2')*((Streamproperties('ws2','sTmp2'))-(Streamproperties('ws2','sTmp1')))*CP_s)/2)/(CP_s*r*(Streamproperties('ws3','sTmp1')-Streamproperties('ws3','sTmp2'))));
 411   
 412  *==============================================================================================================
 413  *CHP: DESUPERHEATING AND CONDENSERS
 414  *==============================================================================================================
 415  Sets
 416  Cndr    Condensers for LPS MPS and HPS  /cndL, cndM, cndH/
 417  Stm     Steam streams                   /LPSs, MPSs, HPSs/
 418  SStp    Steam properties                /sTemp1, sTemp2, sH1, sH2, sCp1/;
 419   
 420  *Columns: sTemp1 and sTemp2 inlet and outlet temperature [C]; sH1 and sH2 inlet and outlet enthalpy [kJ per kg];
 421  *sCp1 heat capacity [kJ per kg.K]
 422  Table   St_Pr(Stm,SStp) Header steam properties
 423                  sTemp1  sTemp2  sH1     sH2     sCp1
 424          LPSs    154.44  143.61  2752.78 2738.06 2.27
 425          MPSs    193.6   180     2948.90 2787
 426          HPSs    382.22  253     3162.89 2799    2.40;
 427   
 428  Parameters
 429  H_VapL          Enthalpy of vaporisation of LPS [kJ per kg]         /2122.72/
 430  H_VapM          Enthalpy of vaporisation of MPS [kJ per kg]         /1965.18/
 431  H_VapH          Enthalpy of vaporisation of HPS [kJ per kg]         /1690.7/
 432  Tw_in           Cooling-water inlet temperature [C]                 /25/
 433  Tw_out          Cooling-water outlet of the header condensers [C]   /45/
 434  Cp_wt           Heat capacity of cooling water [kJ per kg.K]        /4.18/
 435  AF_cnd          Annualisation factor of the condensers [1 per year] /0.322/
 436  CF_cnd          Fixed cost of a condenser installation [$]          /13000/
 437  AC_cnd          Area cost coefficient of the condensers [$ per m2]  /1000/
 438  AE_cnd          Area cost exponent of the condensers                /0.83/
 439  hf_CndC         Saturated liquid enthalpy at 0.1 bar [kJ per kg]    /191.81/
 440  Ts_CndC         Saturation temperature at 0.1 bar [C]               /45.81/
 441  TwC_out         Cooling-water outlet of the turbine-1 condenser [C] /35/
 442  LMTD_CndC       Log-mean temperature difference of the turbine-1 condenser [K]
 443  dT1_Hdr(Cndr)   Steam inlet less cooling-water outlet [K]
 444  dT2_Hdr(Cndr)   Steam outlet less cooling-water inlet [K]
 445  LMTD_Hdr(Cndr)  Log-mean temperature difference of the header condensers [K]
 446  cw_Cnd(Cndr)    Cooling water per kg of steam condensed [kg per kg]
 447  kA_Cnd(Cndr)    Condenser area per kg per s of cooling water [m2.s per kg];
 448   
 449  LMTD_CndC       = ((Ts_CndC - Tw_in) - (Ts_CndC - TwC_out))/log((Ts_CndC - Tw_in)/(Ts_CndC - TwC_out));
 450   
 451  dT1_Hdr('cndL') = St_Pr('LPSs','sTemp1') - Streamproperties('ws6','sTmp2');
 452  dT2_Hdr('cndL') = St_Pr('LPSs','sTemp2') - Streamproperties('ws6','sTmp1');
 453  dT1_Hdr('cndM') = St_Pr('MPSs','sTemp1') - Streamproperties('ws6','sTmp2');
 454  dT2_Hdr('cndM') = St_Pr('MPSs','sTemp2') - Streamproperties('ws6','sTmp1');
 455  dT1_Hdr('cndH') = St_Pr('HPSs','sTemp1') - Streamproperties('ws6','sTmp2');
 456  dT2_Hdr('cndH') = St_Pr('HPSs','sTemp2') - Streamproperties('ws6','sTmp1');
 457  LMTD_Hdr(Cndr)  = (dT1_Hdr(Cndr) - dT2_Hdr(Cndr))/log(dT1_Hdr(Cndr)/dT2_Hdr(Cndr));
 458   
 459  cw_Cnd('cndL')  = H_VapL/(Cp_wt*(Tw_out-Tw_in));
 460  cw_Cnd('cndM')  = H_VapM/(Cp_wt*(Tw_out-Tw_in));
 461  cw_Cnd('cndH')  = H_VapH/(Cp_wt*(Tw_out-Tw_in));
 462  kA_Cnd(Cndr)    = (Streamproperties('ws6','sTmp2') - Streamproperties('ws6','sTmp1'))*CP_s/(LMTD_Hdr(Cndr)*U_st);
 463   
 464  Positive Variables
 465  mw_ds1      Spray water to desuperheat the LPS [kg per s]
 466  mw_ds2      Spray water to desuperheat the MPS [kg per s]
 467  mw_ds3      Spray water to desuperheat the HPS sent to the HEN [kg per s]
 468  MPSd        Desuperheated MPS including spray water [kg per s]
 469  HPSd        Desuperheated HPS for the HEN including spray water [kg per s]
 470  LPSd        Desuperheated LPS including spray water [kg per s]
 471  Cl_WtC      Cooling water for the turbine-1 condenser [kg per s]
 472  A_CndC      Turbine-1 condenser area [m2]
 473  CndC_cst    Turbine-1 condenser capital cost [$ per year];
 474   
 475  Equations
 476  Emw_ds1     LPS spray water
 477  emw_ds2     MPS spray water
 478  Emw_ds3     HPS spray water
 479  EMPSd       MPS after desuperheating
 480  ELPSd       LPS after desuperheating
 481  EHPSd       HPS for the HEN after desuperheating
 482  EWt_C       Cooling water of the turbine-1 condenser
 483  EA_CndC     Area of the turbine-1 condenser
 484  ECndC_cst   Annualised cost of the turbine-1 condenser;
 485   
 486  *Desuperheating
 487  Emw_ds1$act('1')..
 488      mw_ds1 =e= (LPS*(h_LPS-h_LPSd))/(h_LPSd-hw_ds);
 489  emw_ds2$act('1')..
 490      mw_ds2 =e= (MPS*(h_MPS-h_MPSd))/(h_MPSd-hw_ds);
 491  Emw_ds3$act('1')..
 492      mw_ds3 =e= (InletflowHEN*(h_HPS-h_HPSd))/(h_HPSd-hw_ds);
 493  EMPSd$act('1')..
 494      MPSd =e= MPS + mw_ds2;
 495  ELPSd$act('1')..
 496      LPSd =e= LPS + mw_ds1;
 497  EHPSd$act('1')..
 498      HPSd =e= InletflowHEN + mw_ds3;
 499   
 500  *Turbine-1 condenser
 501  EWt_C$act('1')..
 502      Cl_WtC =e= C*(h_Cex - hf_CndC)/(Cp_wt*(TwC_out - Tw_in));
 503  EA_CndC$act('1')..
 504      A_CndC =e= C*(h_Cex - hf_CndC)/(U_st*LMTD_CndC);
 505  ECndC_cst$act('1')..
 506      CndC_cst =e= AF_cnd*(CF_cnd + ((((A_CndC + epsHE)**AE_cnd) - (epsHE**AE_cnd))*AC_cnd));
 507   
 508  *==============================================================================================================
 509  *SCN-CHP: CAPITAL COST AND THE COST COMMON TO ALL ITS COALITIONS
 510  *==============================================================================================================
 511  Parameters
 512  aBl     Boiler cost constant [$]    /130000/
 513  bBl     Boiler cost coefficient     /53/
 514  e1      Boiler cost exponent        /0.9/
 515  aT      Turbine cost constant [$]   /-14000/
 516  bT      Turbine cost coefficient    /1900/
 517  e2      Turbine cost exponent       /0.75/
 518  AF_CHP  Annualisation factor of the boiler and turbines [1 per year];
 519   
 520  AF_CHP = AF_cnd;
 521   
 522  Positive Variables
 523  SA_cst  Solar capital cost [$]
 524  CHP_cst Annualised boiler and turbine cost [$ per year];
 525   
 526  Variables
 527  SCN_CHP_com SCN-CHP cost common to all its Coalitions [$ per year];
 528   
 529  Equations
 530  ESA_cst         Solar capital cost
 531  ECHP_cst        Annualised boiler and turbine cost
 532  ESCN_CHP_com    SCN-CHP cost common to all its Coalitions;
 533   
 534  ESA_cst$act('1')..
 535      SA_cst =e= (ASP*SPc)+(VST*CST)+((((AHE1 + epsHE)**CI) - (epsHE**CI))*CHE)+(HEI*S_A);
 536   
 537  ECHP_cst$act('1')..
 538      CHP_cst =e= AF_CHP*(aBl + bBl*((HPST*3600 + epsHE)**e1) + sum(T, aT + bT*(P(T)**e2)));
 539   
 540  ESCN_CHP_com$act('1')..
 541      SCN_CHP_com =e= sum((sp,f,s), TFC(f,sp,s)) + TFC2_SUM + wTC + SA_cst + CndC_cst + CHP_cst;
 542   
 543  *==============================================================================================================
 544  *MULTI-EFFECT EVAPORATOR (MEE)
 545  *==============================================================================================================
 546  Parameters
 547  xF          Mass fraction of salt in the sea-water feed                             /0.035/
 548  xB          Mass fraction of salt in the brine                                      /0.07/
 549  TSteam      Inlet temperature of steam in the first effect [K]                      /373/
 550  TVfinal     Condensation temperature of the final distillate [K]                    /308/
 551  TV1         Temperature of first distillate [K]                                     /373/
 552  U_a         Heating-tube U at 0 K: UHTFFEAC = U_a + U_b*TVavg [kW per m2.K]         /0.8552/
 553  U_b         Slope of heating-tube U with TVavg [kW per m2.K2]                       /0.0047/
 554  Lam_a       Latent heat at 0 K: LambdaAvg = Lam_a - Lam_b*TVavg [kJ per kg]         /3278.8/
 555  Lam_b       Slope of latent heat with TVavg [kJ per kg.K]                           /2.7532/
 556  GOR_f       Gain kept per effect: GOR = NEFF*GOR_f**NEFF                            /0.98/
 557  epsGOR      Offset keeping Distflow over GOR finite                                 /1e-7/
 558  C_evap      Evaporator cost coefficient: AFC = NEFF*C_evap*A**n_evap [$ per year]   /600/
 559  n_evap      Evaporator cost exponent                                                /0.6/
 560  Cp_sw       Heat capacity of the sea-water feed [kJ per kg.K]                       /4.0/
 561  SF_d        Sea-water feed [kg per s]                                               /56/
 562  T_swF       Sea-water feed temperature leaving the final condenser [C]
 563  T_swH       Sea-water feed temperature into the first effect [C]                    /80/
 564  T_stPH      Condensing temperature of the LPS in the sea-water preheater [C]
 565  U_PH_HX     Overall U of the LPS sea-water preheater [kW per m2.K]                  /1.2/
 566  AF_MEE      Annualisation factor of the MEE exchangers [1 per year]                 /0.322/
 567  CF_MEE      Fixed cost per exchanger [$]                                            /13000/
 568  AC_MEE      Area cost coefficient of the MEE exchangers [$ per m2]                  /1000/
 569  AE_MEE      Area cost exponent of the MEE exchangers                                /0.83/
 570  PH_duty     Preheat duty of the sea-water feed from T_swF to T_swH [kW];
 571   
 572  T_swF   = TVfinal - 273;
 573  T_stPH  = steam('sp3','st_Tin');
 574  PH_duty = Cp_sw*SF_d*(T_swH - T_swF);
 575   
 576  Positive Variables
 577  SF              Sea-water feed [kg per s]
 578  Brineflow       Brine flow [kg per s]
 579  TVavg           Average distillate temperature [K]
 580  DeltaTVac       Temperature drop per effect [K]
 581  UHTFFEAC        Overall U of the heating tubes [kW per m2.K]
 582  LambdaAvg       Average latent heat of the distillate [kJ per kg]
 583  Qtotal          Heat transferred in the evaporators [kW]
 584  GOR             Gained output ratio [kg distillate per kg steam]
 585  MS              LPS steam to the first effect [kg per s]
 586  A               Heat-transfer area of each effect [m2]
 587  AFC             Annualised evaporator cost [$ per year]
 588  AOC2            Steam cost of a stand-alone MEE [$ per year]
 589  Distflow        Distillate flow [kg per s]
 590  T_swS           Sea-water feed temperature after the Farm preheat [C]
 591  T_PH_in         Sea-water feed temperature leaving the HEN for the LPS preheater [C]
 592  Q_ext_MEE       Duty of the LPS sea-water preheater [kW]
 593  m_st            LPS to the sea-water preheater [kg per s]
 594  LMTD_MEE        Chen LMTD of the LPS sea-water preheater [K]
 595  A_HX_MEE_PH     Area of the LPS sea-water preheater [m2]
 596  Cst_PH_MEE_HX   Annualised LPS sea-water preheater [$ per year];
 597   
 598  Binary Variables
 599  b_PH    LPS sea-water preheater is built;
 600   
 601  Integer Variables
 602  NEFF    Number of effects;
 603   
 604  Equations
 605  EqSF            Sea-water feed
 606  Massbalance     MEE mass balance
 607  Compbalance     MEE salt balance
 608  EqTVavg         Average distillate temperature
 609  EqDeltaTVac1    Temperature drop per effect
 610  EqUHTFFEAC      Heating-tube U
 611  EqLambdaAvg     Latent heat of the distillate
 612  EqQtotal        Heat to evaporate the distillate
 613  EqQTotal1       Heat transferred in the effects
 614  EqGOR           Gained output ratio
 615  EqMS            Steam needed for the distillate
 616  EqAFC           Annualised evaporator and preheater cost
 617  EqAOC           Steam cost of a stand-alone MEE
 618  EqT_PH          Feed enters the LPS preheater at the Farm outlet temperature when the HEN is absent
 619  EqQ_Ext         Duty of the LPS sea-water preheater
 620  Eq_m_st         LPS to the sea-water preheater
 621  EqQ_PHb         LPS sea-water preheater duty only when it is built
 622  EqLMTD_MEE_HX   Chen LMTD of the LPS sea-water preheater
 623  EqA_MEE_HX      Area of the LPS sea-water preheater
 624  EqCst_PH_MEE_HX Annualised LPS sea-water preheater;
 625   
 626  EqSF$act('2')..
 627      SF =e= SF_d;
 628  Massbalance$act('2')..
 629      Distflow =e= SF - Brineflow;
 630  Compbalance$act('2')..
 631      SF*xF =e= Brineflow*xB;
 632  EqTVavg$act('2')..
 633      TVavg =e= (TSteam + TVfinal)/2;
 634  EqDeltaTVac1$act('2')..
 635      DeltaTVac =e= (TV1 - TVfinal)/NEFF;
 636  EqUHTFFEAC$act('2')..
 637      UHTFFEAC =e= U_a + U_b*TVavg;
 638  EqLambdaAvg$act('2')..
 639      LambdaAvg =e= Lam_a - Lam_b*TVavg;
 640  EqQtotal$act('2')..
 641      Qtotal =e= Distflow*LambdaAvg;
 642  EqQTotal1$act('2')..
 643      Qtotal =e= NEFF*UHTFFEAC*A*DeltaTVac;
 644  EqGOR$act('2')..
 645      GOR =e= NEFF*(GOR_f**NEFF);
 646  EqMS$act('2')..
 647      MS =e= Distflow/(GOR + epsGOR);
 648  EqAFC$act('2')..
 649      AFC =e= NEFF*C_evap*(A**n_evap) + Cst_PH_MEE_HX;
 650  EqAOC$act('2')..
 651      AOC2 =e= steam('sp3','st_p')*(MS + m_st)*3600*OH/1000;
 652   
 653  *Feed heating from T_swF to T_swH: Farm warm water (to T_swS; 24, 234), then the HEN (to T_PH_in; 23, 123, 234, 1234),
 654  *then the LPS preheater
 655  EqT_PH$(act('2') and not act('23'))..
 656      T_PH_in =e= T_swS;
 657  EqQ_Ext$act('2')..
 658      Q_ext_MEE =e= SF*Cp_sw*(T_swH - T_PH_in);
 659  Eq_m_st$act('2')..
 660      m_st =e= Q_ext_MEE/H_VapL;
 661  EqQ_PHb$act('2')..
 662      Q_ext_MEE =l= PH_duty*b_PH;
 663  EqLMTD_MEE_HX$act('2')..
 664      LMTD_MEE =e= ((T_stPH - T_swH)*(T_stPH - T_PH_in)*((T_stPH - T_swH) + (T_stPH - T_PH_in))/2)**(1/3);
 665  EqA_MEE_HX$act('2')..
 666      A_HX_MEE_PH =e= Q_ext_MEE/(U_PH_HX*LMTD_MEE);
 667  EqCst_PH_MEE_HX$act('2')..
 668      Cst_PH_MEE_HX =e= AF_MEE*(CF_MEE*b_PH + ((((A_HX_MEE_PH + epsHE)**AE_MEE) - (epsHE**AE_MEE))*AC_MEE));
 669   
 670  Distflow.lo = 28;
 671  Distflow.up = 31;
 672  GOR.lo      = 8;
 673  GOR.up      = 10;
 674   
 675  *NEFF bounds keep GOR = NEFF*GOR_f**NEFF in [GOR.lo, GOR.up]: DICOPT cannot cut off values of a general integer variable
 676  NEFF.lo     = 10;
 677  NEFF.up     = 13;
 678   
 679  *Start at the smallest NEFF reaching the middle of [GOR.lo, GOR.up]
 680  NEFF.l          = 12;
 681  GOR.l           = NEFF.l*GOR_f**NEFF.l;
 682  SF.l            = SF_d;
 683  Distflow.l      = SF.l*(1 - xF/xB);
 684  Brineflow.l     = SF.l*xF/xB;
 685  TVavg.l         = (TSteam + TVfinal)/2;
 686  DeltaTVac.l     = (TV1 - TVfinal)/NEFF.l;
 687  UHTFFEAC.l      = U_a + U_b*TVavg.l;
 688  LambdaAvg.l     = Lam_a - Lam_b*TVavg.l;
 689  Qtotal.l        = Distflow.l*LambdaAvg.l;
 690  A.l             = Qtotal.l/(NEFF.l*UHTFFEAC.l*DeltaTVac.l);
 691  MS.l            = Distflow.l/(GOR.l + epsGOR);
 692  T_swS.l         = T_swF;
 693  T_PH_in.l       = T_swF;
 694  Q_ext_MEE.l     = SF.l*Cp_sw*(T_swH - T_swF);
 695  m_st.l          = Q_ext_MEE.l/H_VapL;
 696  b_PH.l          = 1;
 697  LMTD_MEE.l      = ((T_stPH - T_swH)*(T_stPH - T_swF)*((T_stPH - T_swH) + (T_stPH - T_swF))/2)**(1/3);
 698  A_HX_MEE_PH.l   = Q_ext_MEE.l/(U_PH_HX*LMTD_MEE.l);
 699  Cst_PH_MEE_HX.l = AF_MEE*(CF_MEE + ((((A_HX_MEE_PH.l + epsHE)**AE_MEE) - (epsHE**AE_MEE))*AC_MEE));
 700  AFC.l           = NEFF.l*C_evap*(A.l**n_evap) + Cst_PH_MEE_HX.l;
 701  AOC2.l          = steam('sp3','st_p')*(MS.l + m_st.l)*3600*OH/1000;
 702   
 703  MS.lo       = 0.99*Distflow.lo/(GOR.up + epsGOR);
 704  SF.lo       = 0.99*Distflow.lo/(1 - xF/xB);
 705  A.lo        = 0.99*Distflow.lo*(Lam_a - Lam_b*(TSteam + TVfinal)/2)/((U_a + U_b*(TSteam + TVfinal)/2)*(TV1 - TVfinal));
 706  T_swS.lo    = T_swF;
 707  T_PH_in.lo  = T_swF;
 708  T_PH_in.up  = T_swH;
 709  LMTD_MEE.lo = T_stPH - T_swH;
 710   
 711  *==============================================================================================================
 712  *HEAT EXCHANGER NETWORK (HEN)
 713  *==============================================================================================================
 714  Sets
 715  i               Hot streams                                 /1*5/
 716  j               Cold streams                                /1*5/
 717  k               Temperature locations (stage boundaries)    /1*4/
 718  data            Stream data columns                         /TIN, TOUT, H, F, COST, CP, RHO/
 719  hut(i)          Hot utilities
 720  hps(i)          Hot process streams
 721  cps(j)          Cold process streams
 722  cut(j)          Cold utilities
 723  sw(j)           Sea-water feed of the MEE                   /4/
 724  st(k)           Stages
 725  first(k)        First temperature location
 726  last(k)         Last temperature location
 727  hx_st(k)        Heat recovery stages
 728  hut_st(k)       Hot utility stages
 729  cut_st(k)       Cold utility stages
 730  fhps(k)         First temperature location of hps(i)
 731  fcps(k)         First temperature location of cps(j)
 732  first_tlhot(k)  Intervals where hps(i) exist
 733  last_tlhot(k)   Last temperature location of hps(i)
 734  first_tlcold(k) Intervals where cps(j) exist
 735  last_tlcold(k)  Last temperature location of cps(j);
 736   
 737  *TIN inlet temperature [C]; TOUT required outlet temperature [C]; H film coefficient [kW per m2.K]; F heat
 738  *capacity flow rate [kW per K]; COST utility cost [$ per kW.year]; CP heat capacity [kJ per kg.K];
 739  *RHO density [kg per m3]
 740  Table   HOTS(i,data)    Hot stream data
 741              TIN     TOUT    H       F       COST    CP      RHO
 742          1   257     256     1.8     0.0     5       3.2     21.65
 743          2   196.60  195.60  1.5     0.0     2       3.6     6.86
 744          3   154     153     1.2     0.0     1       3.4     2.55
 745          4   155.00  85.00   0.5     150.0   0       3.1     810
 746          5   230.00  40.0    0.5     285.0   0       3.3     760;
 747   
 748  Table   COLDS(j,data)   Cold stream data
 749              TIN     TOUT    H       F       COST    CP      RHO
 750          1   25.00   240.00  0.5     140.0   0       3.2     760
 751          2   40      180     0.5     70      0       3.3     790
 752          3   70      100     0.5     120     0       3.5     785
 753          4   0       0       0.5     0       0       0       1025
 754          5   5.0     10.00   0.5     0.0     30      4.2     1000;
 755   
 756  *Cold stream 4 is the sea-water feed of the MEE, present in Coalitions of the MEE and the HEN
 757  COLDS('4','TIN')    = T_swF;
 758  COLDS('4','TOUT')   = T_swH;
 759  COLDS('4','F')      = Cp_sw*SF_d;
 760  COLDS('4','CP')     = Cp_sw;
 761   
 762  Parameters
 763  nhut                Number of hot utilities                                     /3/
 764  ncut                Number of cold utilities                                    /1/
 765  QH(i)               Heat released by hot stream i between TIN and TOUT [kW]
 766  QC(j)               Heat taken by cold stream j between TIN and TOUT [kW]
 767  AF                  Annualisation factor of the HEN exchangers [1 per year]     /0.322/
 768  CF                  Fixed cost per exchanger [$]                                /13000/
 769  AC                  Area cost coefficient of the HEN exchangers [$ per m2]      /1000/
 770  AE                  Area cost exponent of the HEN exchangers                    /0.83/
 771  gamma_var(i,j)      Big-M on the approach temperature when a match is off [K]
 772  EMAT                Exchanger minimum approach temperature [K]                  /1/
 773  epsDT               Offset keeping the Chen LMTD in TERM2 away from zero [K]    /1e-6/
 774  a_hps(i,k)          Intervals in which hps(i) are present
 775  a_cps(j,k)          Intervals in which cps(j) are present
 776  a_hut(i,k)          Intervals in which hot utilities are present
 777  a_cut(j,k)          Intervals in which cold utilities are present
 778  match(i,j,k)        Possible match of hot stream i with cold stream j in stage k
 779  temp_in_hot(i,k)    Location where hot process stream i enters
 780  temp_in_cold(j,k)   Location where cold process stream j enters;
 781   
 782  *Subsets of streams and locations (they need nhut and ncut)
 783  st(k)           = yes$(ord(k) < card(k));
 784  first(k)        = yes$(ord(k) eq 1);
 785  last(k)         = yes$(ord(k) eq card(k));
 786  hut(i)          = yes$(ord(i) <= nhut);
 787  cut(j)          = yes$(ord(j) > card(j)-ncut);
 788  hps(i)          = yes$(ord(i) > nhut);
 789  cps(j)          = yes$(ord(j) <= card(j)-ncut and (not sw(j) or act('23')));
 790  hut_st(k)       = yes$(ord(k) = 1);
 791  cut_st(k)       = yes$(ord(k) = card(k)-1);
 792  hx_st(k)        = yes$(ord(k)>=2 and ord(k)<=card(k)-2);
 793  fhps(k)         = yes$(ord(k)=1);
 794  fcps(k)         = yes$(ord(k)=card(k));
 795  first_tlhot(k)  = yes$(ord(k)>=2 and ord(k)<card(k));
 796  last_tlhot(k)   = yes$(ord(k)=card(k));
 797  first_tlcold(k) = yes$(ord(k)<=card(k)-1);
 798  last_tlcold(k)  = yes$(ord(k)=1);
 799   
 800  *Duty each process stream must give up or take
 801  QH(i) = HOTS(i,'F')*(HOTS(i,'TIN') - HOTS(i,'TOUT'));
 802  QC(j) = COLDS(j,'F')*(COLDS(j,'TOUT') - COLDS(j,'TIN'));
 803   
 804  gamma_var(i,j) = 4000;
 805   
 806  *Initialise flags
 807  a_hps(i,k)$(hps(i) and first_tlhot(k))  = 1;
 808  a_cps(j,k)$(cps(j) and first_tlcold(k)) = 1;
 809  a_hut(i,k)                              = 0;
 810  a_cut(j,k)                              = 0;
 811  match(i,j,k)                            = 0;
 812  temp_in_hot(i,k)                        = 0;
 813  temp_in_cold(j,k)                       = 0;
 814   
 815  *Assign flag values
 816  a_hut(i,k)$(hut(i) and hut_st(k))       = 1;
 817  a_cut(j,k)$(cut(j) and cut_st(k))       = 1;
 818  match(i,j,k)$(st(k) and ((a_hps(i,k) and a_cps(j,k)$(hps(i) and cps(j))) or (a_cut(j,k)$((hps(i) and cut(j)))) or (a_hut(i,k)$((hut(i) and cps(j)))))) = 1;
 819  temp_in_hot(i,k)$hps(i)                 = fhps(k);
 820  temp_in_cold(j,k)$cps(j)                = fcps(k);
 821   
 822  Positive Variables
 823  HENcap      Annualised capital cost of the HEN exchangers [$ per year]
 824  th(i,k)     Temperature of hot stream i as it enters stage k [C]
 825  tc(j,k)     Temperature of cold stream j as it leaves stage k [C]
 826  q(i,j,k)    Heat exchanged between i and j in stage k [kW]
 827  FlowHEN1    Desuperheated HPS used by the HEN as hot utility 1 [kg per s]
 828  FlowHEN2    Desuperheated MPS used by the HEN as hot utility 2 [kg per s]
 829  FlowHEN3    Desuperheated LPS used by the HEN as hot utility 3 [kg per s]
 830  BuyHEN1     HPS the HEN buys in a Coalition with the SCN-CHP [kg per s]
 831  BuyHEN2     MPS the HEN buys in a Coalition with the SCN-CHP [kg per s]
 832  BuyHEN3     LPS the HEN buys in a Coalition with the SCN-CHP [kg per s]
 833  FlowHEN11   Latent heat delivered by hot utility 1 (HPS) [kW]
 834  FlowHEN22   Latent heat delivered by hot utility 2 (MPS) [kW]
 835  FlowHEN33   Latent heat delivered by hot utility 3 (LPS) [kW]
 836  TERM1       Fixed charge of the HEN exchangers [$]
 837  TERM2       Area cost of the HEN exchangers [$]
 838  CUT_Cst     Chilled water bought for the HEN [$ per year]
 839  Q_CUT       Chilled-water duty of the HEN [kW]
 840  F_CUT       Chilled-water flow to the HEN [kg per s]
 841  Q_sw        Heat the HEN gives the sea-water feed of the MEE [kW]
 842  HUT_Cst     Steam bought by a HEN outside a Coalition with the SCN-CHP [$ per year]
 843  HUT_Cst13   Steam the HEN buys in a Coalition with the SCN-CHP [$ per year]
 844  AOC_HEN     Operating cost of a HEN outside a Coalition with the SCN-CHP: bought steam and chilled water [$ per year];
 845   
 846  Binary Variables
 847  y(i,j,k) Match of hot stream i with cold stream j in stage k is used;
 848   
 849  Variables
 850  dt(i,j,k)   Approach between i and j at location k [K];
 851   
 852  Equations
 853  *Temperatures and heat balances
 854  THOT_IN(i,k)                Assignment of hot process stream inlet temperatures
 855  TCOLD_IN(j,k)               Assignment of cold process stream inlet temperatures
 856  TOTAL_HEAT_HOT(i)           Total heat balance of hot process stream hps(i)
 857  TOTAL_HEAT_COLD(j)          Total heat balance of cold process stream cps(j)
 858  STAGE_HEAT_HOT(i,k)         Stage heat balance of hot process stream hps(i)
 859  STAGE_HEAT_COLD(j,k)        Stage heat balance of cold process stream cps(j)
 860  MONOT_HOT(i,k)              Monotonic temperatures of the hot streams
 861  MONOT_COLD(j,k)             Monotonic temperatures of the cold streams
 862  *Logic
 863  LOG_Q_HPS_CPS(i,j,k)        Logical constraint on heat exchanged between hps(i) and cps(j)
 864  LOG_Q_HPS_CUT(i,j,k)        Logical constraint on heat exchanged between hps(i) and cut(j)
 865  LOG_Q_HUT_CPS(i,j,k)        Logical constraint on heat exchanged between hut(i) and cps(j)
 866  LOG_DT_HPS_CPS_HS(i,j,k)    Logical constraint on hot side temperature difference between hps(i) and cps(j)
 867  LOG_DT_HPS_CPS_CS(i,j,k)    Logical constraint on cold side temperature difference between hps(i) and cps(j)
 868  LOG_DT_HPS_CUT_HS(i,j,k)    Logical constraint on hot side temperature difference between hps(i) and cut(j)
 869  LOG_DT_HPS_CUT_CS(i,j,k)    Logical constraint on cold side temperature difference between hps(i) and cut(j)
 870  LOG_DT_HUT_CPS_HS(i,j,k)    Logical constraint on hot side temperature difference between hut(i) and cps(j)
 871  LOG_DT_HUT_CPS_CS(i,j,k)    Logical constraint on cold side temperature difference between hut(i) and cps(j)
 872  *Hot utilities
 873  FlowtoHEN111                Latent heat of hot utility 1
 874  FlowtoHEN222                Latent heat of hot utility 2
 875  FlowtoHEN333                Latent heat of hot utility 3
 876  HEN_HUTconnect1(i)          Hot utility 1 delivers what its matches take
 877  HEN_HUTconnect2(i)          Hot utility 2 delivers what its matches take
 878  HEN_HUTconnect3(i)          Hot utility 3 delivers what its matches take
 879  *Costs
 880  ETERM1                      Fixed charge of the HEN exchangers
 881  ETERM2                      Area cost of the HEN exchangers
 882  EHENcap                     Annualised capital cost of the HEN exchangers
 883  ECUT_Cst                    Chilled-water cost of the HEN
 884  EQ_CUT                      Chilled-water duty of the HEN
 885  EF_CUT                      Chilled-water flow to the HEN
 886  EQ_sw                       Heat the HEN gives the sea-water feed of the MEE
 887  EQ_swT                      Sea-water feed leaves the HEN for the LPS preheater of the MEE
 888  EHUT_Cst                    Steam bought by a HEN outside a Coalition with the SCN-CHP
 889  EHUT_Cst13                  Steam the HEN buys in a Coalition with the SCN-CHP
 890  AOC_HEN_1                   Operating cost of a HEN outside a Coalition with the SCN-CHP: bought steam and chilled water;
 891   
 892  *Inlet temperatures; the sea-water feed enters at T_swS (T_swF without the Farm)
 893  THOT_IN(i,k)$(act('3') and hps(i) and temp_in_hot(i,k))..
 894      th(i,k) =e= HOTS(i,'TIN');
 895  TCOLD_IN(j,k)$(act('3') and cps(j) and temp_in_cold(j,k))..
 896      tc(j,k) =e= COLDS(j,'TIN') + (T_swS - T_swF)$sw(j);
 897   
 898  *Overall heat balance of each stream
 899  TOTAL_HEAT_HOT(i)$(act('3') and hps(i))..
 900      QH(i) =e= sum((j,k)$(match(i,j,k)), q(i,j,k));
 901  TOTAL_HEAT_COLD(j)$(act('3') and cps(j) and not sw(j))..
 902      QC(j) =e= sum((i,k)$(match(i,j,k)), q(i,j,k));
 903   
 904  *Stage heat balances
 905  STAGE_HEAT_HOT(i,k)$(act('3') and hps(i) and sum(j,match(i,j,k)))..
 906      HOTS(i,'F')*(th(i,k)-th(i,k+1)) =e= sum(j$match(i,j,k), q(i,j,k));
 907  STAGE_HEAT_COLD(j,k)$(act('3') and cps(j) and sum(i,match(i,j,k)))..
 908      COLDS(j,'F')*(tc(j,k)-tc(j,k+1)) =e= sum(i$match(i,j,k), q(i,j,k));
 909   
 910  *Monotonic temperatures
 911  MONOT_HOT(i,k)$(act('3') and hps(i) and st(k))..
 912      th(i,k) =g= th(i,k+1);
 913  MONOT_COLD(j,k)$(act('3') and cps(j) and st(k))..
 914      tc(j,k) =g= tc(j,k+1);
 915   
 916  *Heat is exchanged only on a match that is used
 917  LOG_Q_HPS_CPS(i,j,k)$(act('3') and hps(i) and cps(j) and match(i,j,k))..
 918      q(i,j,k) =l= min(QH(i),QC(j))*y(i,j,k);
 919  LOG_Q_HPS_CUT(i,j,k)$(act('3') and hps(i) and cut(j) and match(i,j,k))..
 920      q(i,j,k) =l= QH(i)*y(i,j,k);
 921  LOG_Q_HUT_CPS(i,j,k)$(act('3') and hut(i) and cps(j) and match(i,j,k))..
 922      q(i,j,k) =l= QC(j)*y(i,j,k);
 923   
 924  *Approach temperatures, relaxed by gamma_var when the match is not used
 925  LOG_DT_HPS_CPS_HS(i,j,k)$(act('3') and hps(i) and cps(j) and match(i,j,k))..
 926      dt(i,j,k) =l= th(i,k) - tc(j,k) + gamma_var(i,j)*(1-y(i,j,k));
 927  LOG_DT_HPS_CPS_CS(i,j,k)$(act('3') and hps(i) and cps(j) and match(i,j,k))..
 928      dt(i,j,k+1) =l= th(i,k+1) - tc(j,k+1) + gamma_var(i,j)*(1-y(i,j,k));
 929  LOG_DT_HPS_CUT_HS(i,j,k)$(act('3') and hps(i) and cut(j) and match(i,j,k))..
 930      dt(i,j,k) =l= (th(i,k) - COLDS(j,'TOUT')) + gamma_var(i,j)*(1-y(i,j,k));
 931  LOG_DT_HPS_CUT_CS(i,j,k)$(act('3') and hps(i) and cut(j) and match(i,j,k))..
 932      dt(i,j,k+1) =l= (th(i,k+1) - COLDS(j,'TIN')) + gamma_var(i,j)*(1-y(i,j,k));
 933  LOG_DT_HUT_CPS_HS(i,j,k)$(act('3') and hut(i) and cps(j) and match(i,j,k))..
 934      dt(i,j,k) =l= (HOTS(i,'TIN') - tc(j,k)) + gamma_var(i,j)*(1-y(i,j,k));
 935  LOG_DT_HUT_CPS_CS(i,j,k)$(act('3') and hut(i) and cps(j) and match(i,j,k))..
 936      dt(i,j,k+1) =l= (HOTS(i,'TOUT') - tc(j,k+1)) + gamma_var(i,j)*(1-y(i,j,k));
 937   
 938  *Condensing hot utilities release latent heat only
 939  FlowtoHEN111$act('3')..
 940      FlowHEN11 =e= FlowHEN1*H_VapH;
 941  FlowtoHEN222$act('3')..
 942      FlowHEN22 =e= FlowHEN2*H_VapM;
 943  FlowtoHEN333$act('3')..
 944      FlowHEN33 =e= FlowHEN3*H_VapL;
 945   
 946  HEN_HUTconnect1('1')$act('3')..
 947      FlowHEN11 =e= sum((j,k),q('1',j,k)$(hut('1') and hut_st(k) and match('1',j,k)));
 948  HEN_HUTconnect2('2')$act('3')..
 949      FlowHEN22 =e= sum((j,k),q('2',j,k)$(hut('2') and hut_st(k) and match('2',j,k)));
 950  HEN_HUTconnect3('3')$act('3')..
 951      FlowHEN33 =e= sum((j,k),q('3',j,k)$(hut('3') and hut_st(k) and match('3',j,k)));
 952   
 953  *Exchanger cost
 954  ETERM1$act('3')..
 955      TERM1 =e= CF*sum((i,j,k)$(match(i,j,k)),y(i,j,k));
 956  *Area cost of every possible match (hot process stream - cold process stream, hot process stream - cold utility,
 957  *hot utility - cold process stream), with the Chen approximation of the LMTD
 958  ETERM2$act('3')..
 959      TERM2 =e= AC*sum((i,j,k)$match(i,j,k),(q(i,j,k)*(1/HOTS(i,'H')+1/COLDS(j,'H'))/((((epsDT**3)+(dt(i,j,k)*dt(i,j,k+1))*((dt(i,j,k)+dt(i,j,k+1))*0.5))**0.3333)+epsDT)+epsDT)**AE);
 960  EHENcap$act('3')..
 961      HENcap =e= AF*(TERM1 + TERM2);
 962   
 963  *Chilled water: cost, duty and flow
 964  ECUT_Cst$act('3')..
 965      CUT_Cst =e= sum((i,j,k)$(hps(i) and cut(j) and match(i,j,k)),COLDS(j,'COST')*q(i,j,k));
 966  EQ_CUT$act('3')..
 967      Q_CUT =e= sum((i,j,k)$(hps(i) and cut(j) and match(i,j,k)),q(i,j,k));
 968  EF_CUT$act('3')..
 969      F_CUT =e= Q_CUT/sum(cut, COLDS(cut,'CP')*(COLDS(cut,'TOUT') - COLDS(cut,'TIN')));
 970   
 971  *Sea-water feed (cold stream 4): the HEN supplies any heat up to its duty to T_swH, the LPS preheater the rest
 972  EQ_sw$act('23')..
 973      Q_sw =e= sum((i,sw,k)$match(i,sw,k), q(i,sw,k));
 974  EQ_swT$act('23')..
 975      T_PH_in =e= T_swS + Q_sw/(SF*Cp_sw);
 976  Q_sw.fx$(not act('23')) = 0;
 977   
 978  *Steam bought by the HEN
 979  EHUT_Cst$act('3')..
 980      HUT_Cst =e= (((FlowHEN1*steam('sp1','st_p'))+(FlowHEN2*steam('sp2','st_p'))+(FlowHEN3*steam('sp3','st_p')))*3600*OH/1000);
 981  EHUT_Cst13$act('13')..
 982      HUT_Cst13 =e= (BuyHEN1*steam('sp1','st_p') + BuyHEN2*steam('sp2','st_p') + BuyHEN3*steam('sp3','st_p'))*3600*OH/1000;
 983  AOC_HEN_1$act('3')..
 984      AOC_HEN =e= (((FlowHEN1*steam('sp1','st_p'))+(FlowHEN2*steam('sp2','st_p'))+(FlowHEN3*steam('sp3','st_p')))*3600*OH/1000) + CUT_Cst;
 985   
 986  *Approach temperatures start at the inlet difference
 987  dt.l(i,j,k)$match(i,j,k)    = HOTS(i,'TIN')-COLDS(j,'TIN');
 988  dt.l(i,j,k+1)$match(i,j,k)  = HOTS(i,'TIN')-COLDS(j,'TIN');
 989  dt.lo(i,j,k)$match(i,j,k)   = EMAT;
 990  dt.lo(i,j,k+1)$match(i,j,k) = EMAT;
 991  dt.up(i,j,k)$match(i,j,k)   = 400;
 992  dt.up(i,j,k+1)$match(i,j,k) = 400;
 993   
 994  *Heat loads start at, and are bounded by, the smaller of the two duties
 995  q.l(i,j,k)$(hps(i) and cps(j) and match(i,j,k))     = min(QH(i),QC(j));
 996  q.l(i,j,k)$(hps(i) and cut(j) and match(i,j,k))     = QH(i);
 997  q.l(i,j,k)$(hut(i) and cps(j) and match(i,j,k))     = QC(j);
 998  q.up(i,j,k)$(hps(i) and cps(j) and match(i,j,k))    = min(QH(i),QC(j));
 999  q.up(i,j,k)$(hps(i) and cut(j) and match(i,j,k))    = QH(i);
1000  q.up(i,j,k)$(hut(i) and cps(j) and match(i,j,k))    = QC(j);
1001  q.l(i,sw,k)$match(i,sw,k)                           = 0;
1002   
1003  *Initialisations and bounds for intermediate temperatures
1004  th.l(i,k)$(first(k))                = HOTS(i,'TIN');
1005  tc.l(j,k)$(last(k))                 = COLDS(j,'TIN');
1006  th.lo(i,k)$(last(k))                = HOTS(i,'TOUT');
1007  th.up(i,k)$(first(k))               = HOTS(i,'TIN');
1008  tc.lo(j,k)$(last(k))                = COLDS(j,'TIN');
1009  tc.up(j,k)$(first(k) and cps(j))    = COLDS(j,'TOUT');
1010   
1011  *Upper bounds on the HEN steam flows, far above any solution flow
1012  FlowHEN1.up = 999;
1013  FlowHEN2.up = 3000;
1014  FlowHEN3.up = 1999;
1015   
1016  *==============================================================================================================
1017  *STEAM LINKS BETWEEN THE SCN-CHP, MEE AND HEN
1018  *==============================================================================================================
1019  *With the SCN-CHP the HEN draws desuperheated steam from it and may buy more (EHUT_Cst13); without it the HEN buys all its
1020  *steam (EHUT_Cst)
1021  Equations
1022  FlowtoHEN1  The HEN takes all the desuperheated HPS and any HPS it buys in a Coalition with the SCN-CHP
1023  FlowtoHEN2  HEN MPS within the desuperheated MPS and the MPS it buys in a Coalition with the SCN-CHP
1024  FlowtoHEN3  HEN LPS within the desuperheated LPS and the LPS it buys in a Coalition with the SCN-CHP
1025  FlowtoHEN3b LPS covers MEE steam and preheater and HEN LPS not bought in a Coalition of the SCN-CHP with the MEE and HEN
1026  FlowtoHEN3c LPS covers the MEE steam and preheater in a Coalition of the SCN-CHP with the MEE;
1027   
1028  FlowtoHEN1$act('13')..
1029      FlowHEN1 =e= HPSd + BuyHEN1;
1030  FlowtoHEN2$act('13')..
1031      MPSd + BuyHEN2 =g= FlowHEN2;
1032  FlowtoHEN3$act('13')..
1033      LPSd + BuyHEN3 =g= FlowHEN3;
1034   
1035  *LPS covers the MEE steam and preheater (3c) and the HEN LPS that is not bought (3b)
1036  FlowtoHEN3b$act('123')..
1037      LPSd - MS - m_st + BuyHEN3 =g= FlowHEN3;
1038  FlowtoHEN3c$act('12')..
1039      LPSd - MS - m_st =g= 0;
1040   
1041  *The HEN receives HPS from the SCN-CHP only in a Coalition with it
1042  InletflowHEN.fx$(not act('13')) = 0;
1043   
1044  *==============================================================================================================
1045  *CRYPTO-MINING FARM
1046  *==============================================================================================================
1047  *Alone: grid power and cooling water, heat dumped.
1048  *With the SCN-CHP: CHP power above D_ind (ESCN_CHP_Pw), warm water preheats the boiler feed. With the MEE but not the
1049  *SCN-CHP: warm water preheats the MEE sea-water feed. No link to the HEN.
1050   
1051  Parameters
1052  hashP           'Mean hashprice from Blockchain.com daily data [$ per PH/s per day]'            /36.31/
1053  c_MF            Mean Megaflex active energy charge [c per kWh]                                  /182.00/
1054  c_lev           Per-kWh charges on all consumption [c per kWh]                                  /35.03/
1055  cr_netfix       Megaflex capacity charges [R per kVA per month]                                 /88.84/
1056  cr_pf           Farm power factor                                                               /0.95/
1057  cr_eff          Miner efficiency [J per TH]                                                     /12/
1058  cr_asic         'ASIC (mining chip) price [$ per TH/s]'                                         /14.59/
1059  cr_infra        Farm infrastructure cost [$ per kW]                                             /300/
1060  cr_PUE          Power usage effectiveness                                                       /1.05/
1061  cr_pool         Mining pool fee                                                                 /0.02/
1062  cr_avail        Miner availability                                                              /0.97/
1063  cr_CapMin       Smallest Farm when built [kW]                                                   /599/
1064  cr_lifeA        ASIC replacement interval [year]                                                /3/
1065  cr_lifeI        Infrastructure life [year]                                                      /10/
1066  cr_rate         Discount rate for annualising [1 per year]                                      /0.10/
1067  cr_OM           Fixed O&M as a fraction of capital [1 per year]                                 /0.03/
1068  cr_kBTC         BTC price multiplier (--BTCMULT)                                                /1.2/
1069  T_cr            Farm cooling-water outlet [C]                                                   /60/
1070  dT_cr           Approach in the Farm's exchangers [K]                                           /5/
1071  r_m             Mining revenue per kWh of Farm electricity [$ per kWh]
1072  p_buy           Grid price paid by a Farm without the SCN-CHP [$ per kWh]
1073  cr_cA           ASIC capital per kW of Farm [$ per kW]
1074  cr_ann          Annualised capital and fixed O&M per kW of Farm [$ per kW per year]
1075  cr_fix          Megaflex capacity charges per kW of grid-supplied Farm [$ per kW per year]
1076  cr_CapMax       Largest Farm: the two turbine maxima [kW]
1077  QcrMax          Heat the largest Farm sends to its cooling water [kW]
1078  U_cr            U of the Farm's exchangers [kW per m2.K]
1079  T_fw            Cold boiler feed temperature [C];
1080   
1081  r_m             = cr_kBTC*(hashP/1000)*(1 - cr_pool)/(0.024*cr_eff*cr_PUE);
1082  p_buy           = (c_MF + c_lev)/(100*FX);
1083  cr_cA           = cr_asic*1000/(cr_eff*cr_PUE);
1084  cr_ann          = cr_cA*cr_rate*(1 + cr_rate)**cr_lifeA/((1 + cr_rate)**cr_lifeA - 1) + cr_infra*cr_rate*(1 + cr_rate)**cr_lifeI/((1 + cr_rate)**cr_lifeI - 1) + cr_OM*(cr_cA + cr_infra);
1085  cr_fix          = 12*cr_netfix/(cr_pf*FX);
1086  cr_CapMax       = sum(T, MaxG(T));
1087  QcrMax          = cr_CapMax/cr_PUE;
1088   
1089  U_cr            = U_st;
1090  T_fw            = Streamproperties('ws1','sTmp1');
1091   
1092  HPSTmax         = smin(s, sum(sp, capacity(sp,s)*BE*NC(sp)/(OH*DS(s))))/(h_HPS - h_fw - CP_s*(Streamproperties('ws2','sTmp2') - Streamproperties('ws2','sTmp1')) - CP_s*(T_cr - dT_cr - T_fw));
1093   
1094  Positive Variables
1095  CR_Cap          Farm electrical capacity including cooling [kW]
1096  CR_Pgr          Grid power bought by the Farm [kW]
1097  CR_Qdmp         Farm heat leaving with the discharged cooling water [kW]
1098  CR_Fcw          Farm cooling water [kg per s]
1099  CR_Fw           Warm water to the boiler-feed exchanger [kg per s]
1100  A_crB           Area of the Farm-to-boiler-feed exchanger [m2]
1101  CR_capc         Annualised Farm capital and fixed O&M [$ per year]
1102  CR_rev          Mining revenue [$ per year]
1103  CR_grid         Grid energy bought by the Farm [$ per year]
1104  CR_HXB          Annualised Farm-to-boiler-feed exchanger [$ per year]
1105  Q_crS           Farm heat added to the sea-water feed of the MEE [kW]
1106  A_crS           Area of the Farm-to-sea-water exchanger [m2]
1107  T_crS           Farm warm water leaving the Farm-to-sea-water exchanger [C]
1108  LMTD_crS        Chen LMTD of the Farm-to-sea-water exchanger [K]
1109  CR_HXS          Annualised Farm-to-sea-water exchanger [$ per year]
1110  CR_cw           Farm cooling-water cost [$ per year];
1111   
1112  Binary Variables
1113  b_cr            Farm is built
1114  b_crB           Farm-to-boiler-feed exchanger is built
1115  b_crS           Farm-to-sea-water exchanger is built;
1116   
1117  Equations
1118  CR_CapL         Farm capacity at least cr_CapMin when built
1119  CR_CapU         Farm capacity zero when not built
1120  CR_Avl          Farm runs at its available capacity
1121  CR_Heat         Farm heat: the preheat and the rest leaves with the cooling water
1122  CR_cwE          Farm cooling water
1123  CR_cwcE         Farm cooling-water cost
1124  CR_QBT          Boiler-feed preheat within what the warm water can heat the cold feed to
1125  CR_QBh          Boiler-feed preheat within what the warm water can give before it is dT_cr above the cold feed
1126  CR_QBb          Boiler-feed preheat only when its exchanger is built
1127  CR_AB           Farm-to-boiler-feed exchanger sized for the preheat duty
1128  CR_HXBE         Annualised Farm-to-boiler-feed exchanger
1129  CR_FwE          Warm water to the boiler-feed exchanger
1130  CR_QST          Sea-water preheat within what the warm water can heat the feed to
1131  CR_TswS         Sea-water feed temperature after the Farm preheat
1132  CR_TcrS         Farm warm water temperature after the sea-water preheat
1133  CR_LMS          Chen LMTD of the Farm-to-sea-water exchanger
1134  CR_QSb          Sea-water preheat only when its exchanger is built
1135  CR_AS           Farm-to-sea-water exchanger sized for the preheat duty
1136  CR_HXSE         Annualised Farm-to-sea-water exchanger
1137  CR_capE         Annualised Farm capital and fixed O&M
1138  CR_revE         Mining revenue
1139  CR_gridE        Grid energy bought by the Farm;
1140   
1141  CR_CapL$act('4')..
1142      CR_Cap =g= cr_CapMin*b_cr;
1143  CR_CapU$act('4')..
1144      CR_Cap =l= cr_CapMax*b_cr;
1145   
1146  CR_Avl$act('4')..
1147      CR_Pco + CR_Pgr =e= cr_avail*CR_Cap;
1148   
1149  CR_Heat$act('4')..
1150      CR_Qdmp =e= (CR_Pco + CR_Pgr)/cr_PUE - Q_crB - Q_crS;
1151   
1152  CR_cwE$act('4')..
1153      CR_Fcw*Cp_wt*(T_cr - Tw_in) =e= (OH*CR_Pco + HY*CR_Pgr)/(OH*cr_PUE);
1154  CR_cwcE$act('4')..
1155      CR_cw =e= CR_Fcw*Streamproperties('ws6','sCst')*3.6*OH;
1156   
1157  CR_QBT$act('14')..
1158      Q_crB =l= HPST*CP_s*(T_cr - dT_cr - T_fw);
1159  CR_QBh$act('14')..
1160      Q_crB =l= (CR_Pco + CR_Pgr)/cr_PUE*(T_cr - dT_cr - T_fw)/(T_cr - Tw_in);
1161  CR_QBb$act('14')..
1162      Q_crB =l= QcrMax*b_crB;
1163   
1164  CR_AB$act('14')..
1165      A_crB =e= Q_crB/(U_cr*dT_cr);
1166  CR_HXBE$act('14')..
1167      CR_HXB =e= AF_cnd*(CF_cnd*b_crB + ((((A_crB + epsHE)**AE_cnd) - (epsHE**AE_cnd))*AC_cnd));
1168   
1169  CR_FwE$act('14')..
1170      CR_Fw =e= Q_crB/(Cp_wt*(T_cr - dT_cr - T_fw));
1171   
1172  *Warm water heats the MEE feed from T_swF to T_swS ahead of the HEN and LPS preheater (duty cut kW for kW). The cooling
1173  *water passes the exchanger in counterflow and leaves at T_crS, at least dT_cr above the feed (T_crS.lo)
1174  CR_QST$(act('24') and not act('1'))..
1175      Q_crS =l= SF*Cp_sw*(T_cr - dT_cr - T_swF);
1176  CR_TswS$(act('24') and not act('1'))..
1177      T_swS =e= T_swF + Q_crS/(SF*Cp_sw);
1178  CR_TcrS$(act('24') and not act('1'))..
1179      Q_crS*(T_cr - Tw_in) =e= (CR_Pco + CR_Pgr)/cr_PUE*(T_cr - T_crS);
1180  CR_QSb$(act('24') and not act('1'))..
1181      Q_crS =l= QcrMax*b_crS;
1182   
1183  CR_LMS$(act('24') and not act('1'))..
1184      LMTD_crS =e= ((T_cr - T_swS)*(T_crS - T_swF)*((T_cr - T_swS) + (T_crS - T_swF))/2)**(1/3);
1185  CR_AS$(act('24') and not act('1'))..
1186      A_crS =e= Q_crS/(U_cr*LMTD_crS);
1187  CR_HXSE$(act('24') and not act('1'))..
1188      CR_HXS =e= AF_cnd*(CF_cnd*b_crS + ((((A_crS + epsHE)**AE_cnd) - (epsHE**AE_cnd))*AC_cnd));
1189   
1190  CR_capE$act('4')..
1191      CR_capc =e= cr_ann*CR_Cap;
1192  CR_revE$act('4')..
1193      CR_rev =e= r_m*(OH*CR_Pco + HY*CR_Pgr);
1194  CR_gridE$act('4')..
1195      CR_grid =e= HY*p_buy*CR_Pgr;
1196   
1197  CR_Cap.up                   = cr_CapMax;
1198  CR_Fw.up                    = QcrMax/(Cp_wt*(T_cr - dT_cr - T_fw));
1199  T_crS.lo                    = T_swF + dT_cr;
1200  T_crS.up                    = T_cr;
1201  LMTD_crS.lo                 = dT_cr;
1202   
1203  CR_Cap.l                    = cr_CapMin;
1204  b_cr.l                      = 1;
1205  Q_crB.l                     = 1000;
1206  A_crB.l                     = 1000/(U_cr*dT_cr);
1207  CR_Fw.l                     = 1000/(Cp_wt*(T_cr - dT_cr - T_fw));
1208  b_crB.l                     = 1;
1209  Q_crS.l                     = 300;
1210  T_crS.l                     = max(T_crS.lo, T_cr - Q_crS.l*(T_cr - Tw_in)/(cr_avail*max(cr_CapMin, 1)/cr_PUE));
1211  LMTD_crS.l                  = ((T_cr - T_swF)*(T_crS.l - T_swF)*((T_cr - T_swF) + (T_crS.l - T_swF))/2)**(1/3);
1212  A_crS.l                     = Q_crS.l/(U_cr*LMTD_crS.l);
1213  b_crS.l                     = 1;
1214   
1215  CR_Pco.fx$(not act('14'))   = 0;
1216  Q_crB.fx$(not act('14'))    = 0;
1217  Q_crS.fx$(not (act('24') and not act('1'))) = 0;
1218  T_swS.fx$(not (act('24') and not act('1'))) = T_swF;
1219  CR_Pgr.fx$act('14')         = 0;
1220   
1221  *==============================================================================================================
1222  *SCN-CHP EcO IN EACH COALITION
1223  *==============================================================================================================
1224  Positive Variables
1225  *Stand-alone SCN-CHP
1226  Cl_Wt(Cndr) Cooling water of each header condenser of the stand-alone SCN-CHP [kg per s]
1227  Wt_Total    Total cooling water of the stand-alone SCN-CHP [kg per s]
1228  Wt_cost     Cooling-water cost of the stand-alone SCN-CHP [$ per year]
1229  A_CndL      LPS condenser area of the stand-alone SCN-CHP [m2]
1230  A_CndM      MPS condenser area of the stand-alone SCN-CHP [m2]
1231  A_CndH      HPS condenser area of the stand-alone SCN-CHP [m2]
1232  Cnd_Cst     Annualised header-condenser cost of the stand-alone SCN-CHP [$ per year]
1233  *Coalition 12
1234  Cl_wtLa     Cooling water of the LPS condenser in Coalition 12 [kg per s]
1235  A_CndLa     LPS condenser area in Coalition 12 [m2]
1236  Cnd_csta    Annualised header-condenser cost in Coalition 12 [$ per year]
1237  wt_totalA   Total cooling water in Coalition 12 [kg per s]
1238  wt_costA    Cooling-water cost in Coalition 12 [$ per year]
1239  *Coalition 13 (the MPS and HPS condensers also serve Coalition 123)
1240  Cl_wtLb     Cooling water of the LPS condenser in Coalition 13 [kg per s]
1241  Cl_WtMb     Cooling water of the MPS condenser in Coalitions 13 and 123 [kg per s]
1242  Cl_WtHb     Cooling water of the HPS condenser in Coalitions 13 and 123 [kg per s]
1243  A_CndLb     LPS condenser area in Coalition 13 [m2]
1244  A_CndMb     MPS condenser area in Coalitions 13 and 123 [m2]
1245  A_CndHb     HPS condenser area in Coalitions 13 and 123 [m2]
1246  Cnd_cstb    Annualised header-condenser cost in Coalition 13 [$ per year]
1247  wt_totalB   Total cooling water in Coalition 13 [kg per s]
1248  wt_costB    Cooling-water cost in Coalition 13 [$ per year]
1249  *Coalition 123
1250  Cl_WtLc     Cooling water of the LPS condenser in Coalition 123 [kg per s]
1251  A_CndLc     LPS condenser area in Coalition 123 [m2]
1252  Cnd_cstc    Annualised header-condenser cost in Coalition 123 [$ per year]
1253  wt_totalc   Total cooling water in Coalition 123 [kg per s]
1254  wt_costC    Cooling-water cost in Coalition 123 [$ per year];
1255   
1256  Variables
1257  SCN_CHP_EcOA        EcO of the stand-alone SCN-CHP [1e5 $ per year]
1258  SCN_CHP_EcOA12      SCN-CHP EcO in Coalition 12 with the MEE [1e5 $ per year]
1259  SCN_CHP_EcOA13      SCN-CHP EcO in Coalition 13 with the HEN [1e5 $ per year]
1260  SCN_CHP_EcOA123     SCN-CHP EcO in Coalition 123 [1e5 $ per year]
1261  SCN_CHP_EcOA14      SCN-CHP EcO in Coalition 14 with the Farm [1e5 $ per year]
1262  SCN_CHP_EcOA124     SCN-CHP EcO in Coalition 124 with the MEE and the Farm [1e5 $ per year]
1263  SCN_CHP_EcOA134     SCN-CHP EcO in Coalition 134 with the HEN and the Farm [1e5 $ per year]
1264  SCN_CHP_EcOA1234    SCN-CHP EcO in Coalition 1234 [1e5 $ per year];
1265   
1266  Equations
1267  *Stand-alone SCN-CHP
1268  EWt_L               Cooling water of the LPS condenser of the stand-alone SCN-CHP
1269  EWt_M               Cooling water of the MPS condenser of the stand-alone SCN-CHP
1270  EWt_H               Cooling water of the HPS condenser of the stand-alone SCN-CHP
1271  EWt_Total           Total cooling water of the stand-alone SCN-CHP
1272  EWt_Cst             Cooling-water cost of the stand-alone SCN-CHP
1273  EA_CndL             LPS condenser area of the stand-alone SCN-CHP
1274  EA_CndM             MPS condenser area of the stand-alone SCN-CHP
1275  EA_CndH             HPS condenser area of the stand-alone SCN-CHP
1276  ECnd_cst            Annualised header-condenser cost of the stand-alone SCN-CHP
1277  ESCN_CHP_EcOA       EcO of the stand-alone SCN-CHP
1278  *Coalition 12
1279  EWt_La              Cooling water of the LPS condenser in Coalition 12
1280  EA_CndLa            LPS condenser area in Coalition 12
1281  ECnd_csta           Annualised header-condenser cost in Coalition 12
1282  Ewt_totalA          Total cooling water in Coalition 12
1283  EWt_costA           Cooling-water cost in Coalition 12
1284  ESCN_CHP_EcOA12     SCN-CHP EcO in Coalition 12
1285  *Coalition 13
1286  EWt_Lb              Cooling water of the LPS condenser in Coalition 13
1287  EWt_Mb              Cooling water of the MPS condenser in Coalitions 13 and 123
1288  EWt_Hb              Cooling water of the HPS condenser in Coalitions 13 and 123
1289  EA_CndLb            LPS condenser area in Coalition 13
1290  EA_CndMb            MPS condenser area in Coalitions 13 and 123
1291  EA_CndHb            HPS condenser area in Coalitions 13 and 123
1292  ECnd_cstb           Annualised header-condenser cost in Coalition 13
1293  Ewt_totalB          Total cooling water in Coalition 13
1294  EWt_costB           Cooling-water cost in Coalition 13
1295  ESCN_CHP_EcOA13     SCN-CHP EcO in Coalition 13
1296  *Coalition 123
1297  EWt_Lc              Cooling water of the LPS condenser in Coalition 123
1298  EA_CndLc            LPS condenser area in Coalition 123
1299  ECnd_cstc           Annualised header-condenser cost in Coalition 123
1300  Ewt_totalc          Total cooling water in Coalition 123
1301  EWt_costC           Cooling-water cost in Coalition 123
1302  ESCN_CHP_EcOA123    SCN-CHP EcO in Coalition 123
1303  *Coalitions with the Farm
1304  ESCN_CHP_EcOA14     SCN-CHP EcO in Coalition 14
1305  ESCN_CHP_EcOA124    SCN-CHP EcO in Coalition 124
1306  ESCN_CHP_EcOA134    SCN-CHP EcO in Coalition 134
1307  ESCN_CHP_EcOA1234   SCN-CHP EcO in Coalition 1234;
1308   
1309  *Stand-alone SCN-CHP
1310  EWt_L$act('1')..
1311      Cl_Wt('cndL') =e= LPSd*cw_Cnd('cndL');
1312  EWt_M$act('1')..
1313      Cl_Wt('cndM') =e= MPSd*cw_Cnd('cndM');
1314  EWt_H$act('1')..
1315      Cl_Wt('cndH') =e= HPSd*cw_Cnd('cndH');
1316  EWt_Total$act('1')..
1317      Wt_Total =e= sum((Cndr), Cl_Wt(Cndr)) + Cl_WtC;
1318  EWt_Cst$act('1')..
1319      Wt_cost =e= Wt_Total * (Streamproperties('ws6','sCst'))*3.6*OH;
1320  EA_CndL$act('1')..
1321      A_CndL =e= Cl_Wt('cndL')*kA_Cnd('cndL');
1322  EA_CndM$act('1')..
1323      A_CndM =e= Cl_Wt('cndM')*kA_Cnd('cndM');
1324  EA_CndH$act('1')..
1325      A_CndH =e= Cl_Wt('cndH')*kA_Cnd('cndH');
1326   
1327  ECnd_cst$act('1')..
1328      Cnd_Cst =e= AF_cnd*(CF_cnd + ((((A_CndL + A_CndM + A_CndH + epsHE)**AE_cnd) - (epsHE**AE_cnd))*AC_cnd));
1329  ESCN_CHP_EcOA$act('1')..
1330      SCN_CHP_EcOA =e= (SCN_CHP_com + Wt_cost + Cnd_Cst)/EcOunit;
1331   
1332  *Coalition 12: only the LPS left after the MEE share is condensed
1333  EWt_La$act('12')..
1334      Cl_wtLa =e= (LPSd - MS - m_st)*cw_Cnd('cndL');
1335  EA_CndLa$act('12')..
1336      A_CndLa =e= Cl_wtLa*kA_Cnd('cndL');
1337  ECnd_csta$act('12')..
1338      Cnd_csta =e= AF_cnd*(CF_cnd + ((((A_CndLa + A_CndM + A_CndH + epsHE)**AE_cnd) - (epsHE**AE_cnd))*AC_cnd));
1339  Ewt_totalA$act('12')..
1340      wt_totalA =e= Cl_Wt('cndM')+Cl_Wt('cndH') + Cl_wtLa + Cl_WtC;
1341  EWt_costA$act('12')..
1342      wt_costA =e= (wt_totalA) * (Streamproperties('ws6','sCst'))*3.6*OH;
1343  ESCN_CHP_EcOA12$act('12')..
1344      SCN_CHP_EcOA12 =e= (SCN_CHP_com + wt_costA + Cnd_csta)/EcOunit;
1345   
1346  *Coalition 13: the condensers handle the steam left after the HEN share (EWt_Lb, EWt_Mb, EWt_Hb); the MPS and HPS
1347  *condensers are sized on their own flows (Cl_WtMb, Cl_WtHb)
1348  EWt_Lb$act('13')..
1349      Cl_wtLb =e= (LPSd - FlowHEN3 + BuyHEN3)*cw_Cnd('cndL');
1350  EWt_Mb$act('13')..
1351      Cl_WtMb =e= (MPSd - FlowHEN2 + BuyHEN2)*cw_Cnd('cndM');
1352  EWt_Hb$act('13')..
1353      Cl_WtHb =e= (HPSd - FlowHEN1 + BuyHEN1)*cw_Cnd('cndH');
1354  EA_CndLb$act('13')..
1355      A_CndLb =e= Cl_wtLb*kA_Cnd('cndL');
1356  EA_CndMb$act('13')..
1357      A_CndMb =e= Cl_WtMb*kA_Cnd('cndM');
1358  EA_CndHb$act('13')..
1359      A_CndHb =e= Cl_WtHb*kA_Cnd('cndH');
1360  ECnd_cstb$act('13')..
1361      Cnd_cstb =e= AF_cnd*(CF_cnd + ((((A_CndLb + A_CndMb + A_CndHb + epsHE)**AE_cnd) - (epsHE**AE_cnd))*AC_cnd));
1362  Ewt_totalB$act('13')..
1363      wt_totalB =e= Cl_WtHb + Cl_WtMb + Cl_wtLb + Cl_WtC;
1364  EWt_costB$act('13')..
1365      wt_costB =e= (wt_totalB) * (Streamproperties('ws6','sCst'))*3.6*OH;
1366  ESCN_CHP_EcOA13$act('13')..
1367      SCN_CHP_EcOA13 =e= (SCN_CHP_com + wt_costB + Cnd_cstb)/EcOunit;
1368   
1369  *Coalition 123
1370  EWt_Lc$act('123')..
1371      Cl_WtLc =e= (LPSd - FlowHEN3 + BuyHEN3 - MS - m_st)*cw_Cnd('cndL');
1372  EA_CndLc$act('123')..
1373      A_CndLc =e= Cl_WtLc*kA_Cnd('cndL');
1374  ECnd_cstc$act('123')..
1375      Cnd_cstc =e= AF_cnd*(CF_cnd + ((((A_CndLc + A_CndMb + A_CndHb + epsHE)**AE_cnd) - (epsHE**AE_cnd))*AC_cnd));
1376  Ewt_totalc$act('123')..
1377      wt_totalc =e= Cl_WtHb + Cl_WtMb + Cl_WtLc + Cl_WtC;
1378  EWt_costC$act('123')..
1379      wt_costC =e= (wt_totalc) * (Streamproperties('ws6','sCst'))*3.6*OH;
1380  ESCN_CHP_EcOA123$act('123')..
1381      SCN_CHP_EcOA123 =e= (SCN_CHP_com + wt_costC + Cnd_cstc)/EcOunit;
1382   
1383  *With the Farm: the SCN-CHP EcO has the terms of the same Coalition without it
1384  ESCN_CHP_EcOA14$act('14')..
1385      SCN_CHP_EcOA14 =e= (SCN_CHP_com + Wt_cost + Cnd_Cst)/EcOunit;
1386  ESCN_CHP_EcOA124$act('124')..
1387      SCN_CHP_EcOA124 =e= (SCN_CHP_com + wt_costA + Cnd_csta)/EcOunit;
1388  ESCN_CHP_EcOA134$act('134')..
1389      SCN_CHP_EcOA134 =e= (SCN_CHP_com + wt_costB + Cnd_cstb)/EcOunit;
1390  ESCN_CHP_EcOA1234$act('1234')..
1391      SCN_CHP_EcOA1234 =e= (SCN_CHP_com + wt_costC + Cnd_cstc)/EcOunit;
1392   
1393  *==============================================================================================================
1394  *MEE EcO IN EACH COALITION
1395  *==============================================================================================================
1396  Positive Variables
1397  MEE_EcO2    EcO of the stand-alone MEE [1e5 $ per year]
1398  MEE_EcO12   MEE EcO in Coalition 12 [1e5 $ per year]
1399  MEE_EcO23   MEE EcO in Coalition 23 [1e5 $ per year]
1400  MEE_EcO123  MEE EcO in Coalition 123 [1e5 $ per year]
1401  MEE_EcO24   MEE EcO in Coalition 24 with the Farm [1e5 $ per year]
1402  MEE_EcO124  MEE EcO in Coalition 124 [1e5 $ per year]
1403  MEE_EcO234  MEE EcO in Coalition 234 [1e5 $ per year]
1404  MEE_EcO1234 MEE EcO in Coalition 1234 [1e5 $ per year];
1405   
1406  Equations
1407  EMEE_EcO2       EcO of the stand-alone MEE
1408  EMEE_EcO12      MEE EcO in Coalition 12
1409  EMEE_EcO23      MEE EcO in Coalition 23
1410  EMEE_EcO123     MEE EcO in Coalition 123
1411  EMEE_EcO24      MEE EcO in Coalition 24
1412  EMEE_EcO124     MEE EcO in Coalition 124
1413  EMEE_EcO234     MEE EcO in Coalition 234
1414  EMEE_EcO1234    MEE EcO in Coalition 1234;
1415   
1416  *Without the SCN-CHP the MEE buys its LPS (AOC2), less what the Farm (24, 234) and HEN (23, 234) preheat; with it the LPS
1417  *comes from the SCN-CHP (steam links) and the MEE pays only AFC
1418  EMEE_EcO2$act('2')..
1419      MEE_EcO2 =e= (AFC + AOC2)/EcOunit;
1420  EMEE_EcO12$act('12')..
1421      MEE_EcO12 =e= AFC/EcOunit;
1422  EMEE_EcO23$act('23')..
1423      MEE_EcO23 =e= (AFC + AOC2)/EcOunit;
1424  EMEE_EcO123$act('123')..
1425      MEE_EcO123 =e= (AFC)/EcOunit;
1426   
1427  EMEE_EcO24$act('24')..
1428      MEE_EcO24 =e= (AFC + AOC2)/EcOunit;
1429  EMEE_EcO124$act('124')..
1430      MEE_EcO124 =e= AFC/EcOunit;
1431  EMEE_EcO234$act('234')..
1432      MEE_EcO234 =e= (AFC + AOC2)/EcOunit;
1433  EMEE_EcO1234$act('1234')..
1434      MEE_EcO1234 =e= AFC/EcOunit;
1435   
1436  *==============================================================================================================
1437  *HEN EcO IN EACH COALITION
1438  *==============================================================================================================
1439  Positive Variables
1440  HEN_EcO     EcO of the stand-alone HEN [1e5 $ per year]
1441  HEN_EcO13   HEN EcO in Coalition 13 [1e5 $ per year]
1442  HEN_EcO23   HEN EcO in Coalition 23 [1e5 $ per year]
1443  HEN_EcO123  HEN EcO in Coalition 123 [1e5 $ per year]
1444  HEN_EcO34   HEN EcO in Coalition 34 with the Farm [1e5 $ per year]
1445  HEN_EcO134  HEN EcO in Coalition 134 [1e5 $ per year]
1446  HEN_EcO234  HEN EcO in Coalition 234 [1e5 $ per year]
1447  HEN_EcO1234 HEN EcO in Coalition 1234 [1e5 $ per year];
1448   
1449  Equations
1450  EHENEcO3    EcO of the stand-alone HEN
1451  EHENEcO13   HEN EcO in Coalition 13
1452  EHENEcO23   HEN EcO in Coalition 23
1453  EHENEcO123  HEN EcO in Coalition 123
1454  EHENEcO34   HEN EcO in Coalition 34
1455  EHENEcO134  HEN EcO in Coalition 134
1456  EHENEcO234  HEN EcO in Coalition 234
1457  EHENEcO1234 HEN EcO in Coalition 1234;
1458   
1459  EHENEcO3$act('3')..
1460      HEN_EcO =e= (HENcap + AOC_HEN)/EcOunit;
1461  *Chilled water is charged in every Coalition
1462  EHENEcO13$act('13')..
1463      HEN_EcO13 =e= (HENcap + CUT_Cst + HUT_Cst13)/EcOunit;
1464  EHENEcO23$act('23')..
1465      HEN_EcO23 =e= (HENcap + AOC_HEN)/EcOunit;
1466  EHENEcO123$act('123')..
1467      HEN_EcO123 =e= (HENcap + CUT_Cst + HUT_Cst13)/EcOunit;
1468   
1469  *The HEN EcO with the Farm equals that of the Coalition without it
1470  EHENEcO34$act('34')..
1471      HEN_EcO34 =e= (HENcap + AOC_HEN)/EcOunit;
1472  EHENEcO134$act('134')..
1473      HEN_EcO134 =e= (HENcap + CUT_Cst + HUT_Cst13)/EcOunit;
1474  EHENEcO234$act('234')..
1475      HEN_EcO234 =e= (HENcap + AOC_HEN)/EcOunit;
1476  EHENEcO1234$act('1234')..
1477      HEN_EcO1234 =e= (HENcap + CUT_Cst + HUT_Cst13)/EcOunit;
1478   
1479  *==============================================================================================================
1480  *CRYPTO-FARM EcO IN EACH COALITION
1481  *==============================================================================================================
1482  *Negative is a profit
1483  Variables
1484  CR_EcO4     EcO of the stand-alone Farm [1e5 $ per year]
1485  CR_EcO24    Farm EcO in Coalition 24 [1e5 $ per year]
1486  CR_EcO34    Farm EcO in Coalition 34 [1e5 $ per year]
1487  CR_EcO234   Farm EcO in Coalition 234 [1e5 $ per year]
1488  CR_EcO14    Farm EcO in Coalition 14 [1e5 $ per year]
1489  CR_EcO124   Farm EcO in Coalition 124 [1e5 $ per year]
1490  CR_EcO134   Farm EcO in Coalition 134 [1e5 $ per year]
1491  CR_EcO1234  Farm EcO in Coalition 1234 [1e5 $ per year];
1492   
1493  Equations
1494  ECR_EcO4    EcO of the stand-alone Farm
1495  ECR_EcO24   Farm EcO in Coalition 24
1496  ECR_EcO34   Farm EcO in Coalition 34
1497  ECR_EcO234  Farm EcO in Coalition 234
1498  ECR_EcO14   Farm EcO in Coalition 14
1499  ECR_EcO124  Farm EcO in Coalition 124
1500  ECR_EcO134  Farm EcO in Coalition 134
1501  ECR_EcO1234 Farm EcO in Coalition 1234;
1502   
1503  *Without the SCN-CHP: grid power and Megaflex capacity charges. Exchanger to the sea-water feed with the MEE
1504  *(24, 234), to the boiler feed with the SCN-CHP. The Farm exchanges nothing with the HEN: 34 costs it what 4 does; 124, 134
1505  *and 1234 what 14 does
1506  ECR_EcO4$act('4')..
1507      CR_EcO4 =e= (CR_capc + cr_fix*CR_Cap + CR_grid + CR_cw - CR_rev)/EcOunit;
1508  ECR_EcO24$act('24')..
1509      CR_EcO24 =e= (CR_capc + cr_fix*CR_Cap + CR_grid + CR_HXS + CR_cw - CR_rev)/EcOunit;
1510  ECR_EcO34$act('34')..
1511      CR_EcO34 =e= (CR_capc + cr_fix*CR_Cap + CR_grid + CR_cw - CR_rev)/EcOunit;
1512  ECR_EcO234$act('234')..
1513      CR_EcO234 =e= (CR_capc + cr_fix*CR_Cap + CR_grid + CR_HXS + CR_cw - CR_rev)/EcOunit;
1514  ECR_EcO14$act('14')..
1515      CR_EcO14 =e= (CR_capc + CR_HXB + CR_cw - CR_rev)/EcOunit;
1516  ECR_EcO124$act('124')..
1517      CR_EcO124 =e= (CR_capc + CR_HXB + CR_cw - CR_rev)/EcOunit;
1518  ECR_EcO134$act('134')..
1519      CR_EcO134 =e= (CR_capc + CR_HXB + CR_cw - CR_rev)/EcOunit;
1520  ECR_EcO1234$act('1234')..
1521      CR_EcO1234 =e= (CR_capc + CR_HXB + CR_cw - CR_rev)/EcOunit;
1522   
1523  *==============================================================================================================
1524  *EnO OF EACH PLAYER IN EACH COALITION
1525  *==============================================================================================================
1526  *EnO: SCN-CHP fuel and freight CO2 plus cooling-water CO2e; for the others the CO2e of the steam, grid power and cooling
1527  *or chilled water they buy (steam and power from the SCN-CHP count in its EnO). kg per s x 3600 x OH x 1e-6 is kt per year
1528  Positive Variables
1529  *SCN-CHP
1530  SCN_CHP_EnO     EnO of the stand-alone SCN-CHP [kt CO2e per year]
1531  SCN_CHP_EnO12   SCN-CHP EnO in Coalition 12 with the MEE [kt CO2e per year]
1532  SCN_CHP_EnO13   SCN-CHP EnO in Coalition 13 with the HEN [kt CO2e per year]
1533  SCN_CHP_EnO123  SCN-CHP EnO in Coalition 123 [kt CO2e per year]
1534  SCN_CHP_EnO14   SCN-CHP EnO in Coalition 14 with the Farm [kt CO2e per year]
1535  SCN_CHP_EnO124  SCN-CHP EnO in Coalition 124 with the MEE and the Farm [kt CO2e per year]
1536  SCN_CHP_EnO134  SCN-CHP EnO in Coalition 134 with the HEN and the Farm [kt CO2e per year]
1537  SCN_CHP_EnO1234 SCN-CHP EnO in Coalition 1234 [kt CO2e per year]
1538  *MEE
1539  MEE_EnO2    EnO of the stand-alone MEE [kt CO2e per year]
1540  MEE_EnO12   MEE EnO in Coalition 12 [kt CO2e per year]
1541  MEE_EnO23   MEE EnO in Coalition 23 [kt CO2e per year]
1542  MEE_EnO123  MEE EnO in Coalition 123 [kt CO2e per year]
1543  MEE_EnO24   MEE EnO in Coalition 24 with the Farm [kt CO2e per year]
1544  MEE_EnO124  MEE EnO in Coalition 124 [kt CO2e per year]
1545  MEE_EnO234  MEE EnO in Coalition 234 [kt CO2e per year]
1546  MEE_EnO1234 MEE EnO in Coalition 1234 [kt CO2e per year]
1547  *HEN
1548  HEN_EnO     EnO of the stand-alone HEN [kt CO2e per year]
1549  HEN_EnO13   HEN EnO in Coalition 13 [kt CO2e per year]
1550  HEN_EnO23   HEN EnO in Coalition 23 [kt CO2e per year]
1551  HEN_EnO123  HEN EnO in Coalition 123 [kt CO2e per year]
1552  HEN_EnO34   HEN EnO in Coalition 34 with the Farm [kt CO2e per year]
1553  HEN_EnO134  HEN EnO in Coalition 134 [kt CO2e per year]
1554  HEN_EnO234  HEN EnO in Coalition 234 [kt CO2e per year]
1555  HEN_EnO1234 HEN EnO in Coalition 1234 [kt CO2e per year]
1556  *Farm
1557  CR_EnO4     EnO of the stand-alone Farm [kt CO2e per year]
1558  CR_EnO24    Farm EnO in Coalition 24 [kt CO2e per year]
1559  CR_EnO34    Farm EnO in Coalition 34 [kt CO2e per year]
1560  CR_EnO234   Farm EnO in Coalition 234 [kt CO2e per year]
1561  CR_EnO14    Farm EnO in Coalition 14 [kt CO2e per year]
1562  CR_EnO124   Farm EnO in Coalition 124 [kt CO2e per year]
1563  CR_EnO134   Farm EnO in Coalition 134 [kt CO2e per year]
1564  CR_EnO1234  Farm EnO in Coalition 1234 [kt CO2e per year];
1565   
1566  Equations
1567  *SCN-CHP
1568  ESCN_CHP_EnO        EnO of the stand-alone SCN-CHP
1569  ESCN_CHP_EnO12      SCN-CHP EnO in Coalition 12
1570  ESCN_CHP_EnO13      SCN-CHP EnO in Coalition 13
1571  ESCN_CHP_EnO123     SCN-CHP EnO in Coalition 123
1572  ESCN_CHP_EnO14      SCN-CHP EnO in Coalition 14
1573  ESCN_CHP_EnO124     SCN-CHP EnO in Coalition 124
1574  ESCN_CHP_EnO134     SCN-CHP EnO in Coalition 134
1575  ESCN_CHP_EnO1234    SCN-CHP EnO in Coalition 1234
1576  *MEE
1577  EMEE_EnO2           EnO of the stand-alone MEE
1578  EMEE_EnO12          MEE EnO in Coalition 12
1579  EMEE_EnO23          MEE EnO in Coalition 23
1580  EMEE_EnO123         MEE EnO in Coalition 123
1581  EMEE_EnO24          MEE EnO in Coalition 24
1582  EMEE_EnO124         MEE EnO in Coalition 124
1583  EMEE_EnO234         MEE EnO in Coalition 234
1584  EMEE_EnO1234        MEE EnO in Coalition 1234
1585  *HEN
1586  EHEN_EnO3           EnO of the stand-alone HEN
1587  EHEN_EnO13          HEN EnO in Coalition 13
1588  EHEN_EnO23          HEN EnO in Coalition 23
1589  EHEN_EnO123         HEN EnO in Coalition 123
1590  EHEN_EnO34          HEN EnO in Coalition 34
1591  EHEN_EnO134         HEN EnO in Coalition 134
1592  EHEN_EnO234         HEN EnO in Coalition 234
1593  EHEN_EnO1234        HEN EnO in Coalition 1234
1594  *Farm
1595  ECR_EnO4            EnO of the stand-alone Farm
1596  ECR_EnO24           Farm EnO in Coalition 24
1597  ECR_EnO34           Farm EnO in Coalition 34
1598  ECR_EnO234          Farm EnO in Coalition 234
1599  ECR_EnO14           Farm EnO in Coalition 14
1600  ECR_EnO124          Farm EnO in Coalition 124
1601  ECR_EnO134          Farm EnO in Coalition 134
1602  ECR_EnO1234         Farm EnO in Coalition 1234;
1603   
1604  *SCN-CHP: boiler and freight CO2 plus cooling water (as in its EcO)
1605  ESCN_CHP_EnO$act('1')..
1606      SCN_CHP_EnO =e= EmissionsB + EmissionsT + Wt_Total*CO2e('CW')*OH*3600*1e-6;
1607  ESCN_CHP_EnO12$act('12')..
1608      SCN_CHP_EnO12 =e= EmissionsB + EmissionsT + wt_totalA*CO2e('CW')*OH*3600*1e-6;
1609  ESCN_CHP_EnO13$act('13')..
1610      SCN_CHP_EnO13 =e= EmissionsB + EmissionsT + wt_totalB*CO2e('CW')*OH*3600*1e-6;
1611  ESCN_CHP_EnO123$act('123')..
1612      SCN_CHP_EnO123 =e= EmissionsB + EmissionsT + wt_totalc*CO2e('CW')*OH*3600*1e-6;
1613  ESCN_CHP_EnO14$act('14')..
1614      SCN_CHP_EnO14 =e= EmissionsB + EmissionsT + Wt_Total*CO2e('CW')*OH*3600*1e-6;
1615  ESCN_CHP_EnO124$act('124')..
1616      SCN_CHP_EnO124 =e= EmissionsB + EmissionsT + wt_totalA*CO2e('CW')*OH*3600*1e-6;
1617  ESCN_CHP_EnO134$act('134')..
1618      SCN_CHP_EnO134 =e= EmissionsB + EmissionsT + wt_totalB*CO2e('CW')*OH*3600*1e-6;
1619  ESCN_CHP_EnO1234$act('1234')..
1620      SCN_CHP_EnO1234 =e= EmissionsB + EmissionsT + wt_totalc*CO2e('CW')*OH*3600*1e-6;
1621   
1622  *MEE: LPS bought without the SCN-CHP
1623  EMEE_EnO2$act('2')..
1624      MEE_EnO2 =e= (MS + m_st)*CO2e('LPS')*OH*3600*1e-6;
1625  EMEE_EnO12$act('12')..
1626      MEE_EnO12 =e= 0;
1627  EMEE_EnO23$act('23')..
1628      MEE_EnO23 =e= (MS + m_st)*CO2e('LPS')*OH*3600*1e-6;
1629  EMEE_EnO123$act('123')..
1630      MEE_EnO123 =e= 0;
1631  EMEE_EnO24$act('24')..
1632      MEE_EnO24 =e= (MS + m_st)*CO2e('LPS')*OH*3600*1e-6;
1633  EMEE_EnO124$act('124')..
1634      MEE_EnO124 =e= 0;
1635  EMEE_EnO234$act('234')..
1636      MEE_EnO234 =e= (MS + m_st)*CO2e('LPS')*OH*3600*1e-6;
1637  EMEE_EnO1234$act('1234')..
1638      MEE_EnO1234 =e= 0;
1639   
1640  *HEN: bought steam (BuyHEN with the SCN-CHP) and chilled water
1641  EHEN_EnO3$act('3')..
1642      HEN_EnO =e= (FlowHEN1*CO2e('HPS') + FlowHEN2*CO2e('MPS') + FlowHEN3*CO2e('LPS') + F_CUT*CO2e('CW'))*OH*3600*1e-6;
1643  EHEN_EnO13$act('13')..
1644      HEN_EnO13 =e= (BuyHEN1*CO2e('HPS') + BuyHEN2*CO2e('MPS') + BuyHEN3*CO2e('LPS') + F_CUT*CO2e('CW'))*OH*3600*1e-6;
1645  EHEN_EnO23$act('23')..
1646      HEN_EnO23 =e= (FlowHEN1*CO2e('HPS') + FlowHEN2*CO2e('MPS') + FlowHEN3*CO2e('LPS') + F_CUT*CO2e('CW'))*OH*3600*1e-6;
1647  EHEN_EnO123$act('123')..
1648      HEN_EnO123 =e= (BuyHEN1*CO2e('HPS') + BuyHEN2*CO2e('MPS') + BuyHEN3*CO2e('LPS') + F_CUT*CO2e('CW'))*OH*3600*1e-6;
1649  EHEN_EnO34$act('34')..
1650      HEN_EnO34 =e= (FlowHEN1*CO2e('HPS') + FlowHEN2*CO2e('MPS') + FlowHEN3*CO2e('LPS') + F_CUT*CO2e('CW'))*OH*3600*1e-6;
1651  EHEN_EnO134$act('134')..
1652      HEN_EnO134 =e= (BuyHEN1*CO2e('HPS') + BuyHEN2*CO2e('MPS') + BuyHEN3*CO2e('LPS') + F_CUT*CO2e('CW'))*OH*3600*1e-6;
1653  EHEN_EnO234$act('234')..
1654      HEN_EnO234 =e= (FlowHEN1*CO2e('HPS') + FlowHEN2*CO2e('MPS') + FlowHEN3*CO2e('LPS') + F_CUT*CO2e('CW'))*OH*3600*1e-6;
1655  EHEN_EnO1234$act('1234')..
1656      HEN_EnO1234 =e= (BuyHEN1*CO2e('HPS') + BuyHEN2*CO2e('MPS') + BuyHEN3*CO2e('LPS') + F_CUT*CO2e('CW'))*OH*3600*1e-6;
1657   
1658  *Farm: grid power [kW] x HY / 1000 is MWh; CR_Fcw is a mean over OH; CHP power is in the SCN-CHP EnO
1659  ECR_EnO4$act('4')..
1660      CR_EnO4 =e= (CO2e('Elec')*CR_Pgr*HY/1000 + CO2e('CW')*CR_Fcw*3600*OH/1000)/1000;
1661  ECR_EnO24$act('24')..
1662      CR_EnO24 =e= (CO2e('Elec')*CR_Pgr*HY/1000 + CO2e('CW')*CR_Fcw*3600*OH/1000)/1000;
1663  ECR_EnO34$act('34')..
1664      CR_EnO34 =e= (CO2e('Elec')*CR_Pgr*HY/1000 + CO2e('CW')*CR_Fcw*3600*OH/1000)/1000;
1665  ECR_EnO234$act('234')..
1666      CR_EnO234 =e= (CO2e('Elec')*CR_Pgr*HY/1000 + CO2e('CW')*CR_Fcw*3600*OH/1000)/1000;
1667  ECR_EnO14$act('14')..
1668      CR_EnO14 =e= CO2e('CW')*CR_Fcw*3600*OH*1e-6;
1669  ECR_EnO124$act('124')..
1670      CR_EnO124 =e= CO2e('CW')*CR_Fcw*3600*OH*1e-6;
1671  ECR_EnO134$act('134')..
1672      CR_EnO134 =e= CO2e('CW')*CR_Fcw*3600*OH*1e-6;
1673  ECR_EnO1234$act('1234')..
1674      CR_EnO1234 =e= CO2e('CW')*CR_Fcw*3600*OH*1e-6;
1675   
1676  *==============================================================================================================
1677  *OBJECTIVE
1678  *==============================================================================================================
1679  *--OBJ=MOO first minimises EcO and EnO each on its own (bestEcO, bestEnO; points RG = 1 and RG = 0), then MOO_OBJFN for
1680  *each weight RG in between (see SOLVE)
1681  Sets
1682  RG_set              Points of the MOO sweep     /RG1*RG5/;
1683   
1684  Alias (RG_set, RG_pt);
1685   
1686  Parameters
1687  RGAA(RG_set)        Weight of the EcO at each MOO point (--RG2 --RG3 --RG4)             /RG1 0,
1688                                                                                          RG2 0.25,
1689                                                                                          RG3 0.5,
1690                                                                                          RG4 0.75,
1691                                                                                          RG5 1/
1692  RG                  Weight of the EcO at the MOO point solved                           /1/
1693  RGpos               Position in RG_set of the MOO point solved on the way down
1694  bestEcO             Lowest EcO of the Coalition solved [1e5 $ per year]                 /1/
1695  bestEnO             Lowest EnO of the Coalition solved [kt CO2e per year]               /1/
1696  EnOtol              Relative slack on bestEnO for the EcO solve of the point RG = 0     /1e-6/
1697  rg0EcO              Lowest EcO of a usable EcO solve at RG = 0 [1e5 $ per year]         /inf/
1698  scaleEcO            EcO scale in MOO_OBJFN (bestEcO but at least 1) [1e5 $ per year]    /1/
1699  scaleEnO            EnO scale in MOO_OBJFN (bestEnO but at least 1) [kt CO2e per year]  /1/
1700  EcO_store(RG_set)   EcO at each MOO point [1e5 $ per year]
1701  EnO_store(RG_set)   EnO at each MOO point [kt CO2e per year];
1702   
1703  Variables
1704  EcO_OBJFN       Objective for --OBJ=EcO: EcO of the Coalition solved (--COAL) [1e5 $ per year]
1705  EnO_OBJFN       Objective for --OBJ=EnO: EnO of the Coalition solved [kt CO2e per year]
1706  MOO_OBJFN       Objective for --OBJ=MOO: EcO and EnO each over its lowest value and weighted by RG and 1 - RG;
1707   
1708  Equations
1709  EEcO_OBJFN      EcO of the Coalition solved
1710  EEnO_OBJFN      EnO of the Coalition solved
1711  EMOO_OBJFN      Weighted sum of the scaled EcO and EnO;
1712   
1713  EEcO_OBJFN..
1714      EcO_OBJFN =e=
1715      SCN_CHP_EcOA$solved('1') + MEE_EcO2$solved('2') + HEN_EcO$solved('3') + CR_EcO4$solved('4')
1716    + (SCN_CHP_EcOA12 + MEE_EcO12)$solved('12') + (SCN_CHP_EcOA13 + HEN_EcO13)$solved('13') + (SCN_CHP_EcOA14 + CR_EcO14)$solved('14')
1717    + (MEE_EcO23 + HEN_EcO23)$solved('23') + (MEE_EcO24 + CR_EcO24)$solved('24') + (HEN_EcO34 + CR_EcO34)$solved('34')
1718    + (SCN_CHP_EcOA123 + MEE_EcO123 + HEN_EcO123)$solved('123') + (SCN_CHP_EcOA124 + MEE_EcO124 + CR_EcO124)$solved('124')
1719    + (SCN_CHP_EcOA134 + HEN_EcO134 + CR_EcO134)$solved('134') + (MEE_EcO234 + HEN_EcO234 + CR_EcO234)$solved('234')
1720    + (SCN_CHP_EcOA1234 + MEE_EcO1234 + HEN_EcO1234 + CR_EcO1234)$solved('1234');
1721   
1722  EEnO_OBJFN..
1723      EnO_OBJFN =e=
1724      SCN_CHP_EnO$solved('1') + MEE_EnO2$solved('2') + HEN_EnO$solved('3') + CR_EnO4$solved('4')
1725    + (SCN_CHP_EnO12 + MEE_EnO12)$solved('12') + (SCN_CHP_EnO13 + HEN_EnO13)$solved('13') + (SCN_CHP_EnO14 + CR_EnO14)$solved('14')
1726    + (MEE_EnO23 + HEN_EnO23)$solved('23') + (MEE_EnO24 + CR_EnO24)$solved('24') + (HEN_EnO34 + CR_EnO34)$solved('34')
1727    + (SCN_CHP_EnO123 + MEE_EnO123 + HEN_EnO123)$solved('123') + (SCN_CHP_EnO124 + MEE_EnO124 + CR_EnO124)$solved('124')
1728    + (SCN_CHP_EnO134 + HEN_EnO134 + CR_EnO134)$solved('134') + (MEE_EnO234 + HEN_EnO234 + CR_EnO234)$solved('234')
1729    + (SCN_CHP_EnO1234 + MEE_EnO1234 + HEN_EnO1234 + CR_EnO1234)$solved('1234');
1730   
1731  EMOO_OBJFN..
1732      MOO_OBJFN =e= RG*EcO_OBJFN/scaleEcO + (1 - RG)*EnO_OBJFN/scaleEnO;
1733   
1734  *Member EcO and EnO at the last solve. MEMBER_EcO_EnO is a macro: every line but the last ends in a backslash
1735  Parameters
1736  EcOm(player)                EcO of each member in the Coalition solved [1e5 $ per year]
1737  EnOm(player)                EnO of each member in the Coalition solved [kt CO2e per year]
1738  EcOm_store(RG_set,player)   EcO of each member at each MOO point [1e5 $ per year]
1739  EnOm_store(RG_set,player)   EnO of each member at each MOO point [kt CO2e per year];
1740   
1741  $macro MEMBER_EcO_EnO \
1742  EcOm('1') = SCN_CHP_EcOA.l$solved('1') + SCN_CHP_EcOA12.l$solved('12') + SCN_CHP_EcOA13.l$solved('13') + SCN_CHP_EcOA14.l$solved('14') \
1743    + SCN_CHP_EcOA123.l$solved('123') + SCN_CHP_EcOA124.l$solved('124') + SCN_CHP_EcOA134.l$solved('134') + SCN_CHP_EcOA1234.l$solved('1234'); \
1744  EcOm('2') = MEE_EcO2.l$solved('2') + MEE_EcO12.l$solved('12') + MEE_EcO23.l$solved('23') + MEE_EcO24.l$solved('24') \
1745    + MEE_EcO123.l$solved('123') + MEE_EcO124.l$solved('124') + MEE_EcO234.l$solved('234') + MEE_EcO1234.l$solved('1234'); \
1746  EcOm('3') = HEN_EcO.l$solved('3') + HEN_EcO13.l$solved('13') + HEN_EcO23.l$solved('23') + HEN_EcO34.l$solved('34') \
1747    + HEN_EcO123.l$solved('123') + HEN_EcO134.l$solved('134') + HEN_EcO234.l$solved('234') + HEN_EcO1234.l$solved('1234'); \
1748  EcOm('4') = CR_EcO4.l$solved('4') + CR_EcO14.l$solved('14') + CR_EcO24.l$solved('24') + CR_EcO34.l$solved('34') \
1749    + CR_EcO124.l$solved('124') + CR_EcO134.l$solved('134') + CR_EcO234.l$solved('234') + CR_EcO1234.l$solved('1234'); \
1750  EnOm('1') = SCN_CHP_EnO.l$solved('1') + SCN_CHP_EnO12.l$solved('12') + SCN_CHP_EnO13.l$solved('13') + SCN_CHP_EnO14.l$solved('14') \
1751    + SCN_CHP_EnO123.l$solved('123') + SCN_CHP_EnO124.l$solved('124') + SCN_CHP_EnO134.l$solved('134') + SCN_CHP_EnO1234.l$solved('1234'); \
1752  EnOm('2') = MEE_EnO2.l$solved('2') + MEE_EnO12.l$solved('12') + MEE_EnO23.l$solved('23') + MEE_EnO24.l$solved('24') \
1753    + MEE_EnO123.l$solved('123') + MEE_EnO124.l$solved('124') + MEE_EnO234.l$solved('234') + MEE_EnO1234.l$solved('1234'); \
1754  EnOm('3') = HEN_EnO.l$solved('3') + HEN_EnO13.l$solved('13') + HEN_EnO23.l$solved('23') + HEN_EnO34.l$solved('34') \
1755    + HEN_EnO123.l$solved('123') + HEN_EnO134.l$solved('134') + HEN_EnO234.l$solved('234') + HEN_EnO1234.l$solved('1234'); \
1756  EnOm('4') = CR_EnO4.l$solved('4') + CR_EnO14.l$solved('14') + CR_EnO24.l$solved('24') + CR_EnO34.l$solved('34') \
1757    + CR_EnO124.l$solved('124') + CR_EnO134.l$solved('134') + CR_EnO234.l$solved('234') + CR_EnO1234.l$solved('1234');
1758   
1759  *USABLE: CGT returned a solution
1760  $macro USABLE (CGT.modelstat = 1 or CGT.modelstat = 2 or CGT.modelstat = 8)
1761   
1762  *MOO_STORE keeps the EcO and EnO (Coalition and members) at the point RG and saves every symbol in point_<point>.gdx;
1763  *RG0_KEEP stores a EcO solve at RG = 0 that ran to the end with a lower EcO than rg0EcO
1764  $macro MOO_STORE \
1765  MEMBER_EcO_EnO \
1766  EcO_store(RG_set)$(RGAA(RG_set) = RG)           = EcO_OBJFN.l; \
1767  EnO_store(RG_set)$(RGAA(RG_set) = RG)           = EnO_OBJFN.l; \
1768  EcOm_store(RG_set,player)$(RGAA(RG_set) = RG)   = EcOm(player); \
1769  EnOm_store(RG_set,player)$(RGAA(RG_set) = RG)   = EnOm(player); \
1770  loop(RG_pt$(RGAA(RG_pt) = RG), put_utility 'gdxout' / 'point_' RG_pt.tl:0 '.gdx'; execute_unload;);
1771   
1772  $macro RG0_KEEP \
1773  if(USABLE and CGT.solvestat = 1 and EcO_OBJFN.l < rg0EcO - 1e-6, \
1774      rg0EcO = EcO_OBJFN.l; \
1775      MOO_STORE \
1776      execute_unload 'moo_ei.gdx'; \
1777  );
1778   
1779  *==============================================================================================================
1780  *SOLVE
1781  *==============================================================================================================
1782  MODEL CGT /all/;
1783   
1784  *FIX_DESIGN saves the bounds of the integers and fixes the integers at their levels; FREE_DESIGN restores the bounds
1785  Parameters
1786  y_lo(i,j,k)     Lower bound of y
1787  y_up(i,j,k)     Upper bound of y
1788  z_lo(sp,f)      Lower bound of z
1789  z_up(sp,f)      Upper bound of z
1790  int_lo(*)       Lower bounds of the integers S_A NEFF b_PH b_cr b_crB and b_crS
1791  int_up(*)       Upper bounds of the integers S_A NEFF b_PH b_cr b_crB and b_crS;
1792   
1793  $macro FIX_DESIGN \
1794  y_lo(i,j,k)                 = y.lo(i,j,k); \
1795  y_up(i,j,k)                 = y.up(i,j,k); \
1796  z_lo(sp,f)                  = z.lo(sp,f); \
1797  z_up(sp,f)                  = z.up(sp,f); \
1798  int_lo('S_A')               = S_A.lo; \
1799  int_up('S_A')               = S_A.up; \
1800  int_lo('NEFF')              = NEFF.lo; \
1801  int_up('NEFF')              = NEFF.up; \
1802  int_lo('b_PH')              = b_PH.lo; \
1803  int_up('b_PH')              = b_PH.up; \
1804  int_lo('b_cr')              = b_cr.lo; \
1805  int_up('b_cr')              = b_cr.up; \
1806  int_lo('b_crB')             = b_crB.lo; \
1807  int_up('b_crB')             = b_crB.up; \
1808  int_lo('b_crS')             = b_crS.lo; \
1809  int_up('b_crS')             = b_crS.up; \
1810  y.fx(i,j,k)$match(i,j,k)    = round(y.l(i,j,k)); \
1811  S_A.fx                      = round(S_A.l); \
1812  NEFF.fx                     = round(NEFF.l); \
1813  z.fx(sp,f)                  = round(z.l(sp,f)); \
1814  b_PH.fx                     = round(b_PH.l); \
1815  b_cr.fx                     = 1$(CR_Cap.l > 0); \
1816  b_crB.fx                    = round(b_crB.l); \
1817  b_crS.fx                    = round(b_crS.l);
1818   
1819  $macro FREE_DESIGN \
1820  y.lo(i,j,k)     = y_lo(i,j,k); \
1821  y.up(i,j,k)     = y_up(i,j,k); \
1822  z.lo(sp,f)      = z_lo(sp,f); \
1823  z.up(sp,f)      = z_up(sp,f); \
1824  S_A.lo          = int_lo('S_A'); \
1825  S_A.up          = int_up('S_A'); \
1826  NEFF.lo         = int_lo('NEFF'); \
1827  NEFF.up         = int_up('NEFF'); \
1828  b_PH.lo         = int_lo('b_PH'); \
1829  b_PH.up         = int_up('b_PH'); \
1830  b_cr.lo         = int_lo('b_cr'); \
1831  b_cr.up         = int_up('b_cr'); \
1832  b_crB.lo        = int_lo('b_crB'); \
1833  b_crB.up        = int_up('b_crB'); \
1834  b_crS.lo        = int_lo('b_crS'); \
1835  b_crS.up        = int_up('b_crS');
1836   
1837  *Warm start (--START=<file>.gdx): load an earlier EcO solution of the same Coalition and fix its integers. The second
1838  *loadpoint names the integers so GAMS treats their levels as set, and CR_Cap, which gives b_cr. --OBJ=MOO fixes them for
1839  *RG = 1 only
1842  execute_loadpoint '..\..\starts\1234.gdx';
1843  execute_loadpoint '..\..\starts\1234.gdx', y, S_A, NEFF, z, b_PH, b_crB, b_crS, CR_Cap;
1844   
1845  *Cross-seeding: replace one player's design in the start by its design in another solution. execute_loadpoint skips
1846  *zero levels, so the player's levels are cleared first
1848   y_lo(i,j,k)                 = y.lo(i,j,k); y_up(i,j,k)                 = y.up(i,j,k); z_lo(sp,f)                  = z.lo(sp,f); z_up(sp,f)                  = z.up(sp,f); int_lo('S_A')               = S_A.lo; int_up('S_A')               = S_A.up; int_lo('NEFF')              = NEFF.lo; int_up('NEFF')              = NEFF.up; int_lo('b_PH')              = b_PH.lo; int_up('b_PH')              = b_PH.up; int_lo('b_cr')              = b_cr.lo; int_up('b_cr')              = b_cr.up; int_lo('b_crB')             = b_crB.lo; int_up('b_crB')             = b_crB.up; int_lo('b_crS')             = b_crS.lo; int_up('b_crS')             = b_crS.up; y.fx(i,j,k)$match(i,j,k)    = round(y.l(i,j,k)); S_A.fx                      = round(S_A.l); NEFF.fx                     = round(NEFF.l); z.fx(sp,f)                  = round(z.l(sp,f)); b_PH.fx                     = round(b_PH.l); b_cr.fx                     = 1$(CR_Cap.l > 0); b_crB.fx                    = round(b_crB.l); b_crS.fx                    = round(b_crS.l);
1850   
1851  *Solver scaling: the large cost variables reach the solver in 1e5 $ per year (the EcO unit); condenser, Farm-exchanger
1852  *and water costs and supply-chain kW are unscaled. Reported levels, bounds and marginals keep their units
1853  CGT.scaleopt                = 1;
1854  TFC.scale(f,sp,s)           = EcOunit;
1855  TotalFuelCost.scale(f,sp,s) = EcOunit;
1856  TFC2.scale(f,sp)            = EcOunit;
1857  TotalFuelCost2.scale(f,sp)  = EcOunit;
1858  TFC2_SUM.scale              = EcOunit;
1859  Etfc2.scale                 = EcOunit;
1860  SA_cst.scale                = EcOunit;
1861  ESA_cst.scale               = EcOunit;
1862  SCN_CHP_com.scale           = EcOunit;
1863  ESCN_CHP_com.scale          = EcOunit;
1864  CHP_cst.scale               = EcOunit;
1865  ECHP_cst.scale              = EcOunit;
1866  ASP.scale                   = 1e3;
1867  AreaSP.scale                = 1e3;
1868  AFC.scale                   = EcOunit;
1869  EqAFC.scale                 = EcOunit;
1870  AOC2.scale                  = EcOunit;
1871  EqAOC.scale                 = EcOunit;
1872  HENcap.scale                = EcOunit;
1873  EHENcap.scale               = EcOunit;
1874  TERM1.scale                 = EcOunit;
1875  TERM2.scale                 = EcOunit;
1876  ETERM1.scale                = EcOunit;
1877  ETERM2.scale                = EcOunit;
1878  HUT_Cst.scale               = EcOunit;
1879  EHUT_Cst.scale              = EcOunit;
1880  HUT_Cst13.scale             = EcOunit;
1881  EHUT_Cst13.scale            = EcOunit;
1882  CUT_Cst.scale               = EcOunit;
1883  ECUT_Cst.scale              = EcOunit;
1884  AOC_HEN.scale               = EcOunit;
1885  AOC_HEN_1.scale             = EcOunit;
1886  Q_fw.scale                  = 1e4;
1887  FeedQ.scale                 = 1e4;
1888  CR_capc.scale               = EcOunit;
1889  CR_capE.scale               = EcOunit;
1890  CR_rev.scale                = EcOunit;
1891  CR_revE.scale               = EcOunit;
1892  CR_grid.scale               = EcOunit;
1893  CR_gridE.scale              = EcOunit;
1894   
1895  option minlp = dicopt;
1896  option mip = cplex;
1897  option nlp = conopt;
1898  option rminlp = conopt;
1899  *After each solve, variables the Coalition does not use go back to 0, so the GDX files hold only the Coalition's levels
1900  option solveOpt = clear;
1901   
1903  *The EcO solve (warm with --START) and the EnO solve give bestEcO, bestEnO and the points RG = 1 and RG = 0. The points in
1904  *between are solved twice, up from the EnO solve and down from the EcO solve (moo_tac.gdx), each from its neighbour, and
1905  *keep the lower MOO_OBJFN. A solve with no solution stops the run going up and is skipped going down, except the last,
1906  *whose levels the results read
1907  RG = 1;
1908  solve CGT using rminlp minimizing EcO_OBJFN;
1909  solve CGT using minlp minimizing EcO_OBJFN;
1910  abort$(not (CGT.modelstat = 1 or CGT.modelstat = 2 or CGT.modelstat = 8)) 'CGT returned no solution at this MOO point', RG, CGT.modelstat;
1911    EcOm('1') = SCN_CHP_EcOA.l$solved('1') + SCN_CHP_EcOA12.l$solved('12') + SCN_CHP_EcOA13.l$solved('13') + SCN_CHP_EcOA14.l$solved('14') + SCN_CHP_EcOA123.l$solved('123') + SCN_CHP_EcOA124.l$solved('124') + SCN_CHP_EcOA134.l$solved('134') + SCN_CHP_EcOA1234.l$solved('1234'); EcOm('2') = MEE_EcO2.l$solved('2') + MEE_EcO12.l$solved('12') + MEE_EcO23.l$solved('23') + MEE_EcO24.l$solved('24') + MEE_EcO123.l$solved('123') + MEE_EcO124.l$solved('124') + MEE_EcO234.l$solved('234') + MEE_EcO1234.l$solved('1234'); EcOm('3') = HEN_EcO.l$solved('3') + HEN_EcO13.l$solved('13') + HEN_EcO23.l$solved('23') + HEN_EcO34.l$solved('34') + HEN_EcO123.l$solved('123') + HEN_EcO134.l$solved('134') + HEN_EcO234.l$solved('234') + HEN_EcO1234.l$solved('1234'); EcOm('4') = CR_EcO4.l$solved('4') + CR_EcO14.l$solved('14') + CR_EcO24.l$solved('24') + CR_EcO34.l$solved('34') + CR_EcO124.l$solved('124') + CR_EcO134.l$solved('134') + CR_EcO234.l$solved('234') + CR_EcO1234.l$solved('1234'); EnOm('1') = SCN_CHP_EnO.l$solved('1') + SCN_CHP_EnO12.l$solved('12') + SCN_CHP_EnO13.l$solved('13') + SCN_CHP_EnO14.l$solved('14') + SCN_CHP_EnO123.l$solved('123') + SCN_CHP_EnO124.l$solved('124') + SCN_CHP_EnO134.l$solved('134') + SCN_CHP_EnO1234.l$solved('1234'); EnOm('2') = MEE_EnO2.l$solved('2') + MEE_EnO12.l$solved('12') + MEE_EnO23.l$solved('23') + MEE_EnO24.l$solved('24') + MEE_EnO123.l$solved('123') + MEE_EnO124.l$solved('124') + MEE_EnO234.l$solved('234') + MEE_EnO1234.l$solved('1234'); EnOm('3') = HEN_EnO.l$solved('3') + HEN_EnO13.l$solved('13') + HEN_EnO23.l$solved('23') + HEN_EnO34.l$solved('34') + HEN_EnO123.l$solved('123') + HEN_EnO134.l$solved('134') + HEN_EnO234.l$solved('234') + HEN_EnO1234.l$solved('1234'); EnOm('4') = CR_EnO4.l$solved('4') + CR_EnO14.l$solved('14') + CR_EnO24.l$solved('24') + CR_EnO34.l$solved('34') + CR_EnO124.l$solved('124') + CR_EnO134.l$solved('134') + CR_EnO234.l$solved('234') + CR_EnO1234.l$solved('1234'); EcO_store(RG_set)$(RGAA(RG_set) = RG)           = EcO_OBJFN.l; EnO_store(RG_set)$(RGAA(RG_set) = RG)           = EnO_OBJFN.l; EcOm_store(RG_set,player)$(RGAA(RG_set) = RG)   = EcOm(player); EnOm_store(RG_set,player)$(RGAA(RG_set) = RG)   = EnOm(player); loop(RG_pt$(RGAA(RG_pt) = RG), put_utility 'gdxout' / 'point_' RG_pt.tl:0 '.gdx'; execute_unload;);
1912  bestEcO = EcO_OBJFN.l;
1913  execute_unload 'moo_tac.gdx';
1915  *The integers are free again after the warm EcO solve
1916   y.lo(i,j,k)     = y_lo(i,j,k); y.up(i,j,k)     = y_up(i,j,k); z.lo(sp,f)      = z_lo(sp,f); z.up(sp,f)      = z_up(sp,f); S_A.lo          = int_lo('S_A'); S_A.up          = int_up('S_A'); NEFF.lo         = int_lo('NEFF'); NEFF.up         = int_up('NEFF'); b_PH.lo         = int_lo('b_PH'); b_PH.up         = int_up('b_PH'); b_cr.lo         = int_lo('b_cr'); b_cr.up         = int_up('b_cr'); b_crB.lo        = int_lo('b_crB'); b_crB.up        = int_up('b_crB'); b_crS.lo        = int_lo('b_crS'); b_crS.up        = int_up('b_crS');
1918  RG = 0;
1919  solve CGT using minlp minimizing EnO_OBJFN;
1920  abort$(not (CGT.modelstat = 1 or CGT.modelstat = 2 or CGT.modelstat = 8)) 'CGT returned no solution at this MOO point', RG, CGT.modelstat;
1921    EcOm('1') = SCN_CHP_EcOA.l$solved('1') + SCN_CHP_EcOA12.l$solved('12') + SCN_CHP_EcOA13.l$solved('13') + SCN_CHP_EcOA14.l$solved('14') + SCN_CHP_EcOA123.l$solved('123') + SCN_CHP_EcOA124.l$solved('124') + SCN_CHP_EcOA134.l$solved('134') + SCN_CHP_EcOA1234.l$solved('1234'); EcOm('2') = MEE_EcO2.l$solved('2') + MEE_EcO12.l$solved('12') + MEE_EcO23.l$solved('23') + MEE_EcO24.l$solved('24') + MEE_EcO123.l$solved('123') + MEE_EcO124.l$solved('124') + MEE_EcO234.l$solved('234') + MEE_EcO1234.l$solved('1234'); EcOm('3') = HEN_EcO.l$solved('3') + HEN_EcO13.l$solved('13') + HEN_EcO23.l$solved('23') + HEN_EcO34.l$solved('34') + HEN_EcO123.l$solved('123') + HEN_EcO134.l$solved('134') + HEN_EcO234.l$solved('234') + HEN_EcO1234.l$solved('1234'); EcOm('4') = CR_EcO4.l$solved('4') + CR_EcO14.l$solved('14') + CR_EcO24.l$solved('24') + CR_EcO34.l$solved('34') + CR_EcO124.l$solved('124') + CR_EcO134.l$solved('134') + CR_EcO234.l$solved('234') + CR_EcO1234.l$solved('1234'); EnOm('1') = SCN_CHP_EnO.l$solved('1') + SCN_CHP_EnO12.l$solved('12') + SCN_CHP_EnO13.l$solved('13') + SCN_CHP_EnO14.l$solved('14') + SCN_CHP_EnO123.l$solved('123') + SCN_CHP_EnO124.l$solved('124') + SCN_CHP_EnO134.l$solved('134') + SCN_CHP_EnO1234.l$solved('1234'); EnOm('2') = MEE_EnO2.l$solved('2') + MEE_EnO12.l$solved('12') + MEE_EnO23.l$solved('23') + MEE_EnO24.l$solved('24') + MEE_EnO123.l$solved('123') + MEE_EnO124.l$solved('124') + MEE_EnO234.l$solved('234') + MEE_EnO1234.l$solved('1234'); EnOm('3') = HEN_EnO.l$solved('3') + HEN_EnO13.l$solved('13') + HEN_EnO23.l$solved('23') + HEN_EnO34.l$solved('34') + HEN_EnO123.l$solved('123') + HEN_EnO134.l$solved('134') + HEN_EnO234.l$solved('234') + HEN_EnO1234.l$solved('1234'); EnOm('4') = CR_EnO4.l$solved('4') + CR_EnO14.l$solved('14') + CR_EnO24.l$solved('24') + CR_EnO34.l$solved('34') + CR_EnO124.l$solved('124') + CR_EnO134.l$solved('134') + CR_EnO234.l$solved('234') + CR_EnO1234.l$solved('1234'); EcO_store(RG_set)$(RGAA(RG_set) = RG)           = EcO_OBJFN.l; EnO_store(RG_set)$(RGAA(RG_set) = RG)           = EnO_OBJFN.l; EcOm_store(RG_set,player)$(RGAA(RG_set) = RG)   = EcOm(player); EnOm_store(RG_set,player)$(RGAA(RG_set) = RG)   = EnOm(player); loop(RG_pt$(RGAA(RG_pt) = RG), put_utility 'gdxout' / 'point_' RG_pt.tl:0 '.gdx'; execute_unload;);
1922  bestEnO = EnO_OBJFN.l;
1923  *The floor of 1 keeps MOO_OBJFN defined for a Coalition whose lowest EcO or EnO is 0 or below (the Farm alone, not built)
1924  scaleEcO = max(bestEcO, 1);
1925  scaleEnO = max(bestEnO, 1);
1926  *The EnO solve leaves its EcO arbitrary, and can stop early with levels far out, so RG = 0 is solved again for the
1927  *lowest EcO with the EnO within EnOtol of bestEnO: with the integers of the EnO solve fixed, from the EnO solve and from the
1928  *EcO solve; free from the first of those; free from the EcO solve. RG = 0 keeps the lowest EcO (the EnO solve if all
1929  *fail) and the way up starts from it (moo_ei.gdx)
1930  EnO_OBJFN.up = bestEnO*(1 + EnOtol);
1931  execute_unload 'moo_ei.gdx';
