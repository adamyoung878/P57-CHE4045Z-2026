  93  *==============================================================================================================
  94  *SCN: FUEL SUPPLY CHAIN
  95  *==============================================================================================================
  96  Sets
  97  sp              Supply points               /CS corn stover,
  98                                               WP Forestry waste,
  99                                               BG Biogas,
 100                                               CL Coal/
 101  f               Freight mode                /road, rail, pipe/
 102  FreightCosts    Freight cost data columns   /FFC, VFC, AF, FIC, tau, RF/
 103  s               Supply chain season         /s1, s2, s3/;
 104   
 105  Table   capacity(sp,s) Capacity of the supply points by season [kg per season]
 106              s1          s2          s3
 107          CS  3000000     4500000     2000000
 108          WP  250000000   210000000   30000000
 109          BG  450000000   500000000   2000000000
 110          CL  50000000    50000000    50000000;
 111   
 112  Table   FeedCost(sp,s) Cost of feedstock from each supply point in each season [$ per kg]
 113              s1          s2          s3
 114          CS  0.024       0.022       0.027
 115          WP  0.04        0.045       0.025
 116          BG  0.05        0.03        0.07
 117          CL  0.9         0.9         0.9;
 118   
 119  *FFC: fixed freight cost [$ per kg]; VFC: variable freight cost [$ per kg.km]; AF: annualisation factor [1 per year];
 120  *FIC: freight investment cost [$ per km]; tau: tortuosity factor; RF: return trip factor
 121  Table   FreightCost(f,FreightCosts) Freight cost data
 122                  FFC     VFC         AF      FIC     tau     RF
 123          road    0.002   0.00009     0.2     5000    1.27    2
 124          rail    0.005   0.000007    0.25    50000   1.1     2
 125          pipe    0.001   0.000001    0.50    150000  1.27    1;
 126   
 127  Parameters
 128  DS(s)       Duration of season as a fraction of the year                        /s1 0.35,
 129                                                                                  s2 0.35,
 130                                                                                  s3 0.3/
 131  NC(sp)      Net calorific value [kWh per kg]                                    /CS 4.63,
 132                                                                                  WP 4.95,
 133                                                                                  BG 5.08,
 134                                                                                  CL 7.20/
 135  BE          Boiler efficiency                                                   /0.75/
 136  d(sp)       Distance between supply points and power generation point [km]      /CS 30,
 137                                                                                  WP 50,
 138                                                                                  BG 38,
 139                                                                                  CL 100/
 140  Ccomp(sp)   Carbon composition of fuel type [kg C per kg fuel]                  /CS 0.47,
 141                                                                                  WP 0.458,
 142                                                                                  BG 0.563,
 143                                                                                  CL 0.775/
 144  RO          Ratio of CO2 to carbon on oxidation (44 over 12) [kg CO2 per kg C]  /3.67/
 145  Emf(f)      Emission factor [g CO2 per t.km]                                    /road 72,
 146                                                                                  rail 35/;
 147   
 148  FeedCost('BG',s) = kBG*FeedCost('BG',s);
 149   
 150  Positive Variables
 151  TFC(f,sp,s) Feedstock and variable freight cost per season [$ per season]
 152  TFC2(f,sp)  Annualised freight investment cost [$ per year]
 153  TFC2_SUM    Total annualised freight investment cost [$ per year]
 154  x(sp,f,s)   Boiler heat output from fuel sp via freight f in season s with BE applied [kW]
 155  bb(sp,s)    Boiler heat output from fuel sp in season s [kW]
 156  EmT(f)      Transport CO2 by freight mode [t per year]
 157  EmB(sp)     Boiler CO2 by fuel [kt per year]
 158  EmissionsT  Transport CO2 [t per year]
 159  EmissionsB  Boiler CO2 [kt per year];
 160   
 161  Binary Variables
 162  z(sp,f)     Freight link from supply point sp by mode f is built;
 163   
 164  Equations
 165  Supply(sp,s)            Boiler heat from sp within its seasonal supply
 166  demand(sp,s)            Boiler heat from sp is the sum over freight modes
 167  FreightCap(sp,f,s)      No freight on a link that is not built
 168  TotalFuelCost(f,sp,s)   Feedstock and variable freight cost
 169  TotalFuelCost2(f,sp)    Annualised freight investment cost
 170  Etfc2                   Total annualised freight investment cost
 171  EEmT(f)                 Transport CO2 by freight mode
 172  EEmissionsT             Total transport CO2
 173  EEmB(sp)                Boiler CO2 by fuel
 174  EEmissionsB             Total boiler CO2;
 175   
 176  Supply(sp,s)$act('1')..
 177      sum((f), x(sp,f,s)) =l= capacity(sp,s)*BE*NC(sp)/(OH*DS(s));
 178  demand(sp,s)$act('1')..
 179      sum((f), x(sp,f,s)) =e= bb(sp,s);
 180  FreightCap(sp,f,s)$act('1')..
 181      x(sp,f,s) =l= capacity(sp,s)*z(sp,f)*BE*NC(sp)/(OH*DS(s));
 182   
 183  TotalFuelCost(f,sp,s)$act('1')..
 184      TFC(f,sp,s) =e= ((FreightCost(f,'FFC') + (FreightCost(f,'VFC')*FreightCost(f,'RF')*FreightCost(f,'tau')*d(sp)))*x(sp,f,s)/(BE*NC(sp)/(OH*DS(s))) + (FeedCost(sp,s) * x(sp,f,s)/(BE*NC(sp)/(OH*DS(s)))));
 185  TotalFuelCost2(f,sp)$act('1')..
 186      TFC2(f,sp) =e= (FreightCost(f,'AF')*FreightCost(f,'FIC') * FreightCost(f,'tau')*z(sp,f)*d(sp));
 187  Etfc2$act('1')..
 188      TFC2_SUM =e= sum((f,sp), TFC2(f,sp));
 189   
 190  EEmT(f)$act('1')..
 191      EmT(f) =e= sum((sp,s), x(sp,f,s)/(BE*NC(sp)/(OH*DS(s)))*d(sp)*FreightCost(f,'tau')*Emf(f))/1e9;
 192  EEmissionsT$act('1')..
 193      EmissionsT =e= sum(f, EmT(f));
 194   
 195  EEmB(sp)$act('1')..
 196      EmB(sp) =e= sum((f,s), x(sp,f,s)/(BE*NC(sp)/(OH*DS(s)))*Ccomp(sp)*RO)/1e6;
 197  EEmissionsB$act('1')..
 198      EmissionsB =e= sum(sp, EmB(sp));
 199   
 200  z.fx('WP','pipe') = 0;
 201  z.fx('CL','pipe') = 0;
 202  z.fx('CS','pipe') = 0;
